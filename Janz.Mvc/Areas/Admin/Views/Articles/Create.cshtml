@model Janz.Mvc.ViewModels.Articles.ArticleCreateVM
@using Janz.Mvc.ViewModels.Journal
@{
    ViewData["Title"] = "New article";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow"><a asp-action="Index">Journal</a> / New</p>
        <h1>New article</h1>
    </div>
</div>

<form class="admin-form" method="post" enctype="multipart/form-data" asp-action="Create">
    <div asp-validation-summary="All" class="admin-errors" role="alert"></div>

    <div class="admin-grid">
        @await Component.InvokeAsync("AdminArticleCreateMain", Model)

        @await Component.InvokeAsync("AdminArticleCreateSide", Model)
    </div>
</form>
