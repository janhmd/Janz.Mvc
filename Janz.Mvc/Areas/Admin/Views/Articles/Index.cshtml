@model List<Janz.Mvc.ViewModels.Articles.ArticleVM>
@{
    ViewData["Title"] = "Journal";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Content</p>
        <h1>Journal <span>@Model.Count</span></h1>
    </div>
    <a class="admin-btn" asp-action="Create"><i class="bi bi-plus"></i> New article</a>
</div>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

@await Component.InvokeAsync("AdminArticlesTable", Model)
