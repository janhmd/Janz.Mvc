@model AdminCommunityVM
@{
    ViewData["Title"] = "Community";
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var count = Model.Tab == "comments" ? Model.Comments.Count : Model.Tab == "reports" ? Model.Reports.Count : Model.Posts.Count;
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Content</p>
        <h1>Community <span>@count</span></h1>
    </div>
</div>

<nav aria-label="Community sections">
    <div class="admin-filter">
        <a class="@(Model.Tab == "posts" ? "is-on" : null)" asp-action="Index" asp-route-tab="posts">Posts</a>
        <a class="@(Model.Tab == "comments" ? "is-on" : null)" asp-action="Index" asp-route-tab="comments">Comments</a>
        <a class="@(Model.Tab == "reports" ? "is-on" : null)" asp-action="Index" asp-route-tab="reports">Reports</a>
    </div>
</nav>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

<div class="admin-card admin-card-flush">
    @if (Model.Tab == "posts")
    {
        @if (Model.Posts.Count == 0)
        {
            <p class="admin-empty admin-card-pad">No posts yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Post</th>
                            <th>Author</th>
                            <th>Score</th>
                            <th>Comments</th>
                            <th>Reports</th>
                            <th>Date</th>
                            <th class="actions">Operations</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var post in Model.Posts)
                        {
                            <tr>
                                <td>
                                    @if (post.IsHidden)
                                    {
                                        <span class="admin-badge">Hidden</span>
                                    }
                                    <span class="admin-review-text">@post.Text</span>
                                </td>
                                <td>@post.Author.Name</td>
                                <td>@post.Score</td>
                                <td>@post.CommentCount</td>
                                <td>@post.Reports</td>
                                <td>@post.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td class="actions">
                                    <span class="admin-actions">
                                        <form method="post" asp-action="@(post.IsHidden ? "ShowPost" : "HidePost")" asp-route-id="@post.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="admin-btn-sm">@(post.IsHidden ? "Show" : "Hide")</button>
                                        </form>
                                        <form method="post" asp-action="DeletePost" asp-route-id="@post.Id" data-confirm="Delete this post with its comments?">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="admin-btn-sm is-danger">Delete</button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else if (Model.Tab == "comments")
    {
        @if (Model.Comments.Count == 0)
        {
            <p class="admin-empty admin-card-pad">No comments yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Comment</th>
                            <th>On post</th>
                            <th>Author</th>
                            <th>Date</th>
                            <th class="actions">Operations</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var comment in Model.Comments)
                        {
                            <tr>
                                <td>
                                    @if (comment.IsHidden)
                                    {
                                        <span class="admin-badge">Hidden</span>
                                    }
                                    <span class="admin-review-text">@comment.Text</span>
                                </td>
                                <td>@comment.PostText</td>
                                <td>@comment.Author.Name</td>
                                <td>@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td class="actions">
                                    <span class="admin-actions">
                                        <form method="post" asp-action="@(comment.IsHidden ? "ShowComment" : "HideComment")" asp-route-id="@comment.Id">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="admin-btn-sm">@(comment.IsHidden ? "Show" : "Hide")</button>
                                        </form>
                                        <form method="post" asp-action="DeleteComment" asp-route-id="@comment.Id" data-confirm="Delete this comment?">
                                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                                            <button type="submit" class="admin-btn-sm is-danger">Delete</button>
                                        </form>
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
    else
    {
        @if (Model.Reports.Count == 0)
        {
            <p class="admin-empty admin-card-pad">No reports yet.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="admin-table">
                    <thead>
                        <tr>
                            <th>Reported</th>
                            <th>Reason</th>
                            <th>Reporter</th>
                            <th>Date</th>
                            <th class="actions">Operations</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in Model.Reports)
                        {
                            <tr>
                                <td>
                                    <span class="admin-badge">@report.Target</span>
                                    @if (report.IsResolved)
                                    {
                                        <span class="admin-badge">Resolved</span>
                                    }
                                    <span class="admin-review-text">@report.TargetText</span>
                                    <small class="admin-muted">by @report.TargetAuthor</small>
                                </td>
                                <td>@report.Reason</td>
                                <td>@report.Reporter</td>
                                <td>@report.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                                <td class="actions">
                                    <span class="admin-actions">
                                        @if (!report.IsResolved)
                                        {
                                            <form method="post" asp-action="Resolve" asp-route-id="@report.Id">
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="admin-btn-sm">Resolve</button>
                                            </form>
                                        }
                                        @if (report.PostId is int postId)
                                        {
                                            <form method="post" asp-action="HidePost" asp-route-id="@postId">
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="admin-btn-sm">Hide post</button>
                                            </form>
                                        }
                                        @if (report.CommentId is int commentId)
                                        {
                                            <form method="post" asp-action="HideComment" asp-route-id="@commentId">
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="admin-btn-sm">Hide comment</button>
                                            </form>
                                        }
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</div>
