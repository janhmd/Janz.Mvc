@using System.Globalization
@model DashboardVM
@{
    ViewData["Title"] = "Dashboard";
    var en = CultureInfo.GetCultureInfo("en-US");
    var maxDay = Model.SalesLast7Days.Count == 0 ? 0 : Model.SalesLast7Days.Max(m => m.Total);
    var canShop = User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin);
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Overview</p>
        <h1>Dashboard</h1>
    </div>
</div>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

<div class="admin-stats">
    <div class="admin-stat is-gold">
        <i class="bi bi-cash-stack"></i>
        <span class="admin-stat-label">Revenue</span>
        <strong>₼@Model.TotalRevenue.ToString("0.00")</strong>
    </div>
    <div class="admin-stat">
        <i class="bi bi-calendar3"></i>
        <span class="admin-stat-label">This month</span>
        <strong>₼@Model.RevenueThisMonth.ToString("0.00")</strong>
    </div>
    <div class="admin-stat">
        <i class="bi bi-bag-check"></i>
        <span class="admin-stat-label">Orders · @Model.OrdersToday today</span>
        <strong>@Model.OrderCount</strong>
    </div>
    <div class="admin-stat">
        <i class="bi bi-hourglass-split"></i>
        <span class="admin-stat-label">Waiting to start</span>
        <strong>@Model.PendingOrders</strong>
    </div>
    <div class="admin-stat">
        <i class="bi bi-receipt"></i>
        <span class="admin-stat-label">Average order</span>
        <strong>₼@Model.AverageOrder.ToString("0.00")</strong>
    </div>
    <div class="admin-stat">
        <i class="bi bi-people"></i>
        <span class="admin-stat-label">Customers · @Model.NewCustomersThisMonth new</span>
        <strong>@Model.CustomerCount</strong>
    </div>
    @if (canShop)
    {
        <a class="admin-stat" asp-controller="Products" asp-action="Index">
            <i class="bi bi-box-seam"></i>
            <span class="admin-stat-label">Products</span>
            <strong>@Model.ProductCount</strong>
        </a>
    }
    else
    {
        <div class="admin-stat">
            <i class="bi bi-box-seam"></i>
            <span class="admin-stat-label">Products</span>
            <strong>@Model.ProductCount</strong>
        </div>
    }
</div>

<div class="admin-grid">
    <div class="admin-stack">
        <div class="admin-card">
            <div class="admin-card-head">
                <h2>Sales, last 7 days</h2>
                <span class="admin-count">₼@Model.SalesLast7Days.Sum(m => m.Total).ToString("0.00")</span>
            </div>
            @* Sütunun hündürlüyü həmin günün satışının həftənin ən çox satışına nisbətidir *@
            <div class="admin-week">
                @foreach (var day in Model.SalesLast7Days)
                {
                    var height = maxDay == 0 ? 0 : (int)Math.Round(day.Total / maxDay * 100);
                    <div class="admin-week-day@(day.Total == 0 ? " is-zero" : null)" title="@day.Orders orders, ₼@day.Total.ToString("0.00")">
                        <span>@(day.Total == 0 ? "" : "₼" + day.Total.ToString("0"))</span>
                        <b style="--h: @(height)%"></b>
                        <small>@day.Date.ToString("ddd d", en)</small>
                    </div>
                }
            </div>
        </div>

        <div class="admin-card admin-card-flush">
            <div class="admin-card-head admin-card-pad">
                <h2>Recent orders</h2>
                <span class="admin-count">@Model.OrderCount</span>
            </div>
            @if (Model.RecentOrders.Count == 0)
            {
                <p class="admin-empty admin-card-pad">No orders yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="admin-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="num">Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.RecentOrders)
                            {
                                <tr>
                                    <td>#@order.Id</td>
                                    <td>@order.CustomerName<br /><small class="admin-muted">@order.CustomerEmail</small></td>
                                    <td>@order.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                    <td><span class="admin-status status-@order.Status.ToLowerInvariant()">@order.Status</span></td>
                                    <td class="num">₼@order.Total.ToString("0.00")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="admin-stack">
        <div class="admin-card">
            <div class="admin-card-head">
                <h2>Orders by status</h2>
            </div>
            <div class="admin-status-row">
                @foreach (var pair in Model.OrdersByStatus)
                {
                    <span class="admin-status status-@pair.Key.ToLowerInvariant()">@pair.Key · @pair.Value</span>
                }
            </div>
        </div>

        <div class="admin-card">
            <div class="admin-card-head">
                <h2>Low stock <span class="admin-count">@Model.LowStock.Count</span></h2>
                @if (canShop && Model.LowStock.Count > 0)
                {
                    <a class="admin-link" asp-controller="Products" asp-action="Index" asp-route-lowStock="true">All</a>
                }
            </div>
            @if (Model.LowStock.Count == 0)
            {
                <p class="admin-empty">Every product has enough stock.</p>
            }
            else
            {
                <ul class="admin-list">
                    @foreach (var product in Model.LowStock)
                    {
                        <li>
                            @* Admin birbaşa redaktəyə keçib stoku artıra bilir *@
                            @if (canShop)
                            {
                                <a asp-controller="Products" asp-action="Edit" asp-route-id="@product.ProductId">@product.Name</a>
                            }
                            else
                            {
                                <span>@product.Name</span>
                            }
                            <span class="admin-stock@(product.Stock == 0 ? " is-out" : null)">@product.Stock left</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <div class="admin-card">
            <div class="admin-card-head">
                <h2>Best sellers</h2>
            </div>
            @if (Model.TopProducts.Count == 0)
            {
                <p class="admin-empty">No sales yet.</p>
            }
            else
            {
                <ul class="admin-list">
                    @foreach (var product in Model.TopProducts)
                    {
                        <li>
                            @if (canShop)
                            {
                                <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.ProductId">@product.Name</a>
                            }
                            else
                            {
                                <span>@product.Name</span>
                            }
                            <span class="admin-muted">@product.Sold sold · ₼@product.Revenue.ToString("0.00")</span>
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
</div>
