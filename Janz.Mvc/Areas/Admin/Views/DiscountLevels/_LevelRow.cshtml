@model Janz.Mvc.ViewModels.DiscountLevels.DiscountLevelVM
@{
    var prefix = $"Levels[{ViewData["Index"]}].";
}

<tr data-level-row>
    <td>
        <input type="hidden" name="@(prefix)Id" value="@Model.Id" />
        <input class="admin-cell-input" name="@(prefix)Name" value="@Model.Name" required maxlength="50" aria-label="Level name" />
    </td>
    <td class="num"><span class="admin-cell-unit">₼<input class="admin-cell-input admin-cell-num" name="@(prefix)MinSpent" type="number" min="0" step="0.01" value="@Model.MinSpent.ToString("0.##")" aria-label="Spent from" /></span></td>
    <td class="num"><span class="admin-cell-unit"><input class="admin-cell-input admin-cell-num" name="@(prefix)Percent" type="number" min="0" max="50" value="@Model.Percent" aria-label="Discount" />%</span></td>
    <td><input class="admin-cell-input admin-cell-wide" name="@(prefix)Perks" value="@Model.Perks" maxlength="200" placeholder="—" aria-label="Perks" /></td>
    <td class="num">@Model.CustomerCount</td>
    <td class="actions"><button type="button" class="admin-btn-sm is-danger" data-level-remove>Delete</button></td>
</tr>
