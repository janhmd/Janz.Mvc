@model Janz.Mvc.ViewModels.GiftCertificates.GiftCertificateListVM
@{
    ViewData["Title"] = "Gift certificates";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Shop</p>
        <h1>Gift certificates <span>@Model.Certificates.Count</span></h1>
    </div>
    <a class="admin-btn" asp-action="Create"><i class="bi bi-plus"></i> New certificate</a>
</div>

<nav aria-label="Filter certificates">
    <div class="admin-filter">
        <a class="@(Model.Status is null ? "is-on" : null)" asp-action="Index">All</a>
        @foreach (var status in Janz.Mvc.ViewModels.GiftCertificates.GiftCertificateListVM.Statuses)
        {
            <a class="@(Model.Status == status ? "is-on" : null)" asp-action="Index" asp-route-status="@status">@status</a>
        }
    </div>
</nav>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

<div class="admin-card admin-card-flush">
    @if (Model.Certificates.Count == 0)
    {
        <p class="admin-empty">No certificates yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th class="num">Amount</th>
                        <th>Valid until</th>
                        <th>Used by</th>
                        <th>Status</th>
                        <th class="actions">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var certificate in Model.Certificates)
                    {
                        var statusClass = certificate.Status switch
                        {
                            "Active" => "status-active",
                            "Used" => "status-scheduled",
                            "Disabled" => "status-disabled",
                            _ => "status-expired"
                        };
                        <tr>
                            <td><code class="admin-code">@certificate.Code</code></td>
                            <td class="num"><strong>₼@certificate.Amount.ToString("0.00")</strong></td>
                            <td>@(certificate.ExpiresAt?.ToString("dd.MM.yyyy") ?? "—")</td>
                            <td>
                                @if (certificate.UsedAt is DateTime usedAt)
                                {
                                    @(certificate.UsedByEmail ?? "Deleted user")
                                    <small class="admin-usage-text">@usedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td><span class="admin-status @statusClass">@certificate.Status</span></td>
                            <td class="actions">
                                <span class="admin-actions">
                                    <a class="admin-btn-sm" asp-action="Edit" asp-route-id="@certificate.Id">Edit</a>
                                    @if (certificate.UsedAt is null)
                                    {
                                        <form method="post" asp-action="Delete" asp-route-id="@certificate.Id" data-confirm="Delete @certificate.Code?">
                                            <button type="submit" class="admin-btn-sm is-danger">Delete</button>
                                        </form>
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
