@model ContactMessageVM
@{
    ViewData["Title"] = $"Message from {Model.Name}";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow"><a asp-action="Index">Messages</a> / #@Model.Id</p>
        <h1>@Model.Topic <span class="admin-status @(Model.IsAnswered ? "status-delivered" : "status-pending")">@(Model.IsClosed ? "Chat ended" : Model.IsAnswered ? "Answered" : "New")</span></h1>
    </div>
</div>

<div class="admin-grid">
    <div class="admin-stack">
        <div class="admin-card">
            <h2>Conversation</h2>
            <div class="chat">
                <div class="chat-msg is-customer">
                    <span class="chat-who">@Model.Name, @Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                    <p>@Model.Message</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Reply))
                {
                    <div class="chat-msg is-staff">
                        <span class="chat-who">Support@(Model.AnsweredAt is DateTime answered ? ", " + answered.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : string.Empty)</span>
                        <p>@Model.Reply</p>
                    </div>
                }
                @foreach (var entry in Model.Entries)
                {
                    <div class="chat-msg @(entry.IsStaff ? "is-staff" : "is-customer")">
                        <span class="chat-who">@(entry.IsStaff ? "Support" : Model.Name), @entry.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                        <p>@entry.Text</p>
                    </div>
                }
            </div>
            @if (Model.IsAnswered || Model.Entries.Count > 0)
            {
                <p class="admin-note">@(Model.IsMember ? "The customer sees these replies in their account under My messages. " : string.Empty)The email is sent when mail is set up in the API.</p>
            }
                @if (!Model.IsClosed)
                {
                    <form method="post" asp-action="Close" asp-route-id="@Model.Id">
                        <button type="submit" class="admin-btn is-ghost">End chat</button>
                        <p class="admin-note">The customer can write again after your reply. End the chat when the question is solved. Only staff can end it.</p>
                    </form>
                }
                @if (Model.IsClosed)
                {
                    <p class="admin-note">Support ended this chat@(Model.ClosedAt is DateTime closed ? " on " + closed.ToLocalTime().ToString("dd.MM.yyyy HH:mm") : string.Empty). No more replies can be added.</p>
                }
        </div>
        @if (!Model.IsAnswered && !Model.IsClosed)
        {
            <form class="admin-card admin-form" method="post" asp-action="Reply" asp-route-id="@Model.Id">
                <h2>Reply</h2>
                <label class="admin-field admin-field-wide">
                    <span>Your reply</span>
                    <textarea name="Reply" rows="8" required maxlength="2000"></textarea>
                    <small>It is sent to @Model.Email. The customer's message is added below your text.</small>
                </label>
                <div class="admin-form-actions">
                    <button type="submit" class="admin-btn">Send reply</button>
                    <button type="submit" class="admin-btn is-ghost" formaction="@Url.Action("Close", new { id = Model.Id })" formnovalidate>End chat</button>
                    <a class="admin-btn is-ghost" asp-action="Index">Cancel</a>
                </div>
            </form>
        }
    </div>
    <div class="admin-stack">
        <div class="admin-card">
            <h2>Customer</h2>
            <dl class="admin-facts">
                <dt>Name</dt><dd>@Model.Name</dd>
                <dt>Email</dt><dd><a href="mailto:@Model.Email">@Model.Email</a></dd>
                <dt>Account</dt><dd>@(Model.IsMember ? "Signed in customer" : "Guest")</dd>
                <dt>Sent</dt><dd>@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</dd>
            </dl>
        </div>
    </div>
</div>

<div class="admin-detail-foot">
    <a class="admin-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to messages</a>
</div>
