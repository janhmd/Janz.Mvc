@model List<AdminNotificationVM>
@{
    ViewData["Title"] = "Notifications";
    var type = ViewBag.Type as string;
    var shown = type is null ? Model : Model.Where(m => m.Type == type).ToList();
    var tabs = new (string Key, string Label, string Icon)[]
    {
        ("order", "Orders", "bi-bag-check"),
        ("report", "Reports", "bi-flag"),
        ("review", "Reviews", "bi-star"),
        ("stock", "Stock", "bi-box-seam")
    };
    var icons = tabs.ToDictionary(m => m.Key, m => m.Icon);
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Customers</p>
        <h1>Notifications <span>@Model.Count</span></h1>
    </div>
</div>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

<nav aria-label="Filter notifications">
    <div class="admin-filter">
        <a class="@(type is null ? "is-on" : null)" asp-action="Index">All</a>
        @foreach (var tab in tabs)
        {
            var count = Model.Count(m => m.Type == tab.Key);
            if (count == 0 && type != tab.Key) continue;
            <a class="@(type == tab.Key ? "is-on" : null)" asp-action="Index" asp-route-type="@tab.Key">@tab.Label <span>@count</span></a>
        }
    </div>
</nav>

@if (shown.Count == 0)
{
    <p class="admin-empty">Nothing needs your attention right now.</p>
}
else
{
    <ul class="admin-notes">
        @foreach (var note in shown)
        {
            <li class="admin-note is-@note.Severity">
                <i class="bi @(icons.TryGetValue(note.Type, out var icon) ? icon : "bi-bell")" aria-hidden="true"></i>
                <div>
                    <a href="@note.Link">@note.Title</a>
                    <p>@note.Text</p>
                </div>
                @if (note.CreatedAt is DateTime created)
                {
                    <time datetime="@created.ToString("o")">@created.ToLocalTime().ToString("d MMM, HH:mm")</time>
                }
            </li>
        }
    </ul>
}
