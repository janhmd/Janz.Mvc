@model List<PageVM>
@{
    ViewData["Title"] = "Pages";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Content</p>
        <h1>Pages <span>@Model.Count</span></h1>
    </div>
</div>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

<div class="admin-card admin-card-flush">
    @if (Model.Count == 0)
    {
        <p class="admin-empty admin-card-pad">No pages yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Page</th>
                        <th>Address</th>
                        <th>Linked from</th>
                        <th>Updated</th>
                        <th class="actions">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><a asp-action="Edit" asp-route-id="@item.Id"><strong>@item.Title</strong></a></td>
                            <td><code>/Pages/@item.Slug</code></td>
                            <td>@(item.InTerms && item.InFooter ? "Header · Footer" : item.InTerms ? "Header" : item.InFooter ? "Footer" : "Not linked")</td>
                            <td>@item.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="actions"><a class="admin-btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
<p class="admin-note">These are the text pages from the Terms menu and the footer. Their addresses stay the same so the links on the site keep working.</p>
