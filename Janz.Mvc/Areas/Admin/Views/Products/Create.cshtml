@model ProductCreateVM
@using System.Globalization
@{
    ViewData["Title"] = "New product";
    // Rəqəmlər həmişə nöqtə ilə (input type="number" vergülü qəbul etmir)
    var price = Model.Price > 0 ? Model.Price.ToString("0.00", CultureInfo.InvariantCulture) : string.Empty;
    var stock = Model.Stock == 0 ? string.Empty : Model.Stock.ToString(CultureInfo.InvariantCulture);
    var oldPrice = Model.OldPrice?.ToString("0.00", CultureInfo.InvariantCulture);
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow"><a asp-action="Index">Products</a> / New</p>
        <h1>New product</h1>
    </div>
</div>

<form class="admin-form" method="post" enctype="multipart/form-data"
      asp-action="Create">
    <div asp-validation-summary="All" class="admin-errors" role="alert"></div>

    <div class="admin-grid">
        @await Component.InvokeAsync("AdminProductCreateMain", Model)

        @await Component.InvokeAsync("AdminProductCreateSide", Model)
    </div>
</form>
