@model ProductVM
@inject IConfiguration Configuration
@{
    ViewData["Title"] = Model.Name;
    var apiBase = Configuration["ApiSettings:BaseUrl"];
    var stockClass = Model.Stock == 0 ? " is-out" : Model.Stock < AdminRules.LowStock ? " is-low" : null;
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow"><a asp-action="Index">Products</a> / #@Model.Id</p>
        <h1>@Model.Name</h1>
    </div>
    <div class="admin-head-actions">
        <a class="admin-btn is-ghost" href="/Products/Detail/@Model.Id" target="_blank" rel="noopener"><i class="bi bi-box-arrow-up-right"></i> On the site</a>
        <a class="admin-btn" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil"></i> Edit</a>
    </div>
</div>

<div class="admin-grid">
    <div class="admin-card">
        <dl class="admin-facts">
            <dt>Category</dt><dd>@Model.CategoryName</dd>
            <dt>Price</dt><dd>₼@Model.Price.ToString("0.00")@(Model.OldPrice is decimal old ? $" (was ₼{old:0.00})" : null)</dd>
            <dt>Stock</dt><dd><span class="admin-stock@(stockClass)">@Model.Stock</span></dd>
            <dt>Use</dt><dd>@(Model.Use ?? "—")</dd>
            <dt>Taste</dt><dd>@(Model.Taste ?? "—")@(Model.Notes.Count > 0 ? " with notes of " + string.Join(", ", Model.Notes) : null)</dd>
            <dt>Density / acidity</dt><dd>@(Model.Density?.ToString() ?? "—") / @(Model.Acidity?.ToString() ?? "—")</dd>
            <dt>Taste group</dt><dd>@(Model.TasteGroup ?? "—")</dd>
            <dt>Brewing methods</dt><dd>@(Model.BrewMethods.Count == 0 ? "—" : string.Join(", ", Model.BrewMethods))</dd>
            <dt>Tags</dt><dd>@(Model.Tags.Count == 0 ? "—" : string.Join(", ", Model.Tags.Select(m => m.Name)))</dd>
            <dt>Badge</dt><dd>@(Model.Badge ?? "—")</dd>
            <dt>In the shop</dt><dd>@(Model.IsVisible ? "Visible" : "Hidden")</dd>
            <dt>Description</dt><dd>@Model.Description</dd>
            @* Boş sahələr göstərilmir, məhsul səhifəsində olduğu kimi *@
            @foreach (var (label, value) in new[] { ("Roast level", Model.Roast), ("Region", Model.Region), ("Processing", Model.Processing), ("Caffeine", Model.Caffeine), ("Brewing", Model.Brewing), ("Storage", Model.Storage) })
            {
                if (!string.IsNullOrWhiteSpace(value))
                {
                    <dt>@label</dt><dd>@value</dd>
                }
            }
        </dl>
    </div>
    <div class="admin-card">
        <div class="admin-gallery">
            <img class="is-main" src="@ApiUrl.ToAbsolute(apiBase, Model.ImagePath)" alt="@Model.Name" />
            @foreach (var image in Model.Images)
            {
                <img src="@ApiUrl.ToAbsolute(apiBase, image)" alt="" />
            }
        </div>
        <p class="admin-note admin-note-top">The gold frame is the main image shown in the catalog.</p>
    </div>
</div>

@if (Model.Variants.Count > 0)
{
    <div class="admin-card admin-card-flush admin-card-gap">
        <div class="table-responsive">
            <table class="admin-table admin-variant-table">
                <thead>
                    <tr>
                        <th>Variant</th>
                        <th class="num">Price</th>
                        <th class="num">Stock</th>
                        <th>Images</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var variant in Model.Variants)
                    {
                        var variantStock = variant.Stock == 0 ? " is-out" : variant.Stock < AdminRules.LowStock ? " is-low" : null;
                        <tr>
                            <td>@variant.Format<small>@variant.Size</small></td>
                            <td class="num">₼@variant.Price.ToString("0.00")@if (variant.OldPrice is decimal was){<small>was ₼@was.ToString("0.00")</small>}</td>
                            <td class="num"><span class="admin-stock@(variantStock)">@variant.Stock</span></td>
                            <td>
                                <span class="admin-variant-images">
                                    @foreach (var image in variant.Images)
                                    {
                                        <img src="@ApiUrl.ToAbsolute(apiBase, image)" alt="" />
                                    }
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="admin-detail-foot">
    <a class="admin-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to products</a>
    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" data-confirm="Delete @Model.Name?">
        <button type="submit" class="admin-btn is-danger-ghost"><i class="bi bi-trash"></i> Delete</button>
    </form>
</div>
