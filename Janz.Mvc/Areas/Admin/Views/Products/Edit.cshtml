@model ProductEditVM
@using System.Globalization
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Edit product";
    var apiBase = Configuration["ApiSettings:BaseUrl"];
    var hasMain = !string.IsNullOrEmpty(Model.ImagePath);
    // Rəqəmlər həmişə nöqtə ilə (input type="number" vergülü qəbul etmir)
    var price = Model.Price > 0 ? Model.Price.ToString("0.00", CultureInfo.InvariantCulture) : string.Empty;
    var stock = Model.Stock.ToString(CultureInfo.InvariantCulture);
    var oldPrice = Model.OldPrice?.ToString("0.00", CultureInfo.InvariantCulture);
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow"><a asp-action="Index">Products</a> / <a asp-action="Detail" asp-route-id="@Model.Id">#@Model.Id</a></p>
        <h1>Edit product</h1>
    </div>
</div>

<form class="admin-form" method="post" enctype="multipart/form-data"
      asp-action="Edit" asp-route-id="@Model.Id">
    <div asp-validation-summary="All" class="admin-errors" role="alert"></div>

    <div class="admin-grid">
        @await Component.InvokeAsync("AdminProductEditMain", Model)

        @await Component.InvokeAsync("AdminProductEditSide", Model)
    </div>
</form>
