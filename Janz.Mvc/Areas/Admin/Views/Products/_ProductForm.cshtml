@model ProductFormVM
@using System.Globalization
@inject IConfiguration Configuration
@{
    var apiBase = Configuration["ApiSettings:BaseUrl"];
    var hasMain = !string.IsNullOrEmpty(Model.ImagePath);
    // Rəqəmlər həmişə nöqtə ilə (input type="number" vergülü qəbul etmir)
    var price = Model.Price > 0 ? Model.Price.ToString("0.00", CultureInfo.InvariantCulture) : string.Empty;
    var stock = Model.IsNew && Model.Stock == 0 ? string.Empty : Model.Stock.ToString(CultureInfo.InvariantCulture);
    var oldPrice = Model.OldPrice?.ToString("0.00", CultureInfo.InvariantCulture);
}

<form class="admin-form" method="post" enctype="multipart/form-data"
      asp-action="@(Model.IsNew ? "Create" : "Edit")" asp-route-id="@(Model.IsNew ? null : Model.Id)">
    <div asp-validation-summary="All" class="admin-errors" role="alert"></div>

    <div class="admin-grid">
        <div class="admin-stack">
            <div class="admin-card">
                <h2>Main</h2>
                <div class="admin-form-grid">
                    <label class="admin-field admin-field-wide">
                        <span>Name</span>
                        <input asp-for="Name" required maxlength="150" />
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>Description</span>
                        <textarea asp-for="Description" rows="5" required maxlength="500"></textarea>
                        <small>Shown on the product page. Up to 500 characters.</small>
                    </label>
                    <div class="admin-field admin-field-wide admin-chips-field">
                        <span>Brewing methods</span>
                        <div class="admin-chips">
                            @foreach (var method in ProductOptions.BrewMethods)
                            {
                                <label class="admin-chip">
                                    <input type="checkbox" name="BrewMethods" value="@method" checked="@Model.BrewMethods.Contains(method)" />
                                    <span>@method</span>
                                </label>
                            }
                        </div>
                        <small>Shown in the Brewing block on the product page.</small>
                    </div>
                    <label class="admin-field admin-field-wide">
                        <span>Brewing note</span>
                        <textarea asp-for="Brewing" rows="2" maxlength="1000" placeholder="Espresso: 18 g in, 36 g out, 27–30 s"></textarea>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>Storage</span>
                        <textarea asp-for="Storage" rows="2" maxlength="500" placeholder="Keep closed, away from light and heat"></textarea>
                    </label>
                </div>
            </div>

            <div class="admin-card">
                <h2>Details</h2>
                <div class="admin-form-grid">
                    <label class="admin-field"><span>Roast level</span><input asp-for="Roast" maxlength="50" placeholder="Espresso" /></label>
                    <label class="admin-field"><span>Region</span><input asp-for="Region" maxlength="50" placeholder="Ethiopia" /></label>
                    <label class="admin-field"><span>Processing</span><input asp-for="Processing" maxlength="50" placeholder="Washed" /></label>
                    <label class="admin-field"><span>Caffeine</span><input asp-for="Caffeine" maxlength="20" placeholder="1.2%" /></label>
                </div>
                <p class="admin-note admin-note-top">Shown in the Details block on the product page. Empty fields are hidden.</p>
            </div>

            <div class="admin-card">
                <h2>Variants <span class="admin-count" data-variant-count>@Model.Variants.Count / @AdminRules.MaxVariants</span></h2>
                <p class="admin-note">Pack types and sizes with their own price, stock and images, for example "Pack · 250 g" or "Nespresso capsules 10 pcs". Without variants the product uses the price and stock on the right.</p>
                <div class="admin-variants" data-variant-list data-max="@AdminRules.MaxVariants">
                    @for (var i = 0; i < Model.Variants.Count; i++)
                    {
                        <partial name="_VariantRow" model="Model.Variants[i]" view-data="@(new ViewDataDictionary(ViewData) { { "Index", i } })" />
                    }
                </div>
                <button type="button" class="admin-btn is-ghost" data-variant-add><i class="bi bi-plus"></i> Add variant</button>
                <template data-variant-template>
                    <partial name="_VariantRow" model="new ProductVariantFormVM()" view-data="@(new ViewDataDictionary(ViewData) { { "Index", "__i__" } })" />
                </template>
                <datalist id="variant-formats">
                    @foreach (var format in ProductOptions.Formats)
                    {
                        <option value="@format"></option>
                    }
                </datalist>
            </div>

            <div class="admin-card">
                <h2>Main image</h2>
                <div class="admin-thumbs" data-preview="main">
                    @if (hasMain)
                    {
                        <figure class="admin-thumb is-main">
                            <img src="@ApiUrl.ToAbsolute(apiBase, Model.ImagePath)" alt="" />
                            <figcaption><span class="admin-thumb-label">Main</span></figcaption>
                        </figure>
                    }
                </div>
                <label class="admin-drop">
                    <input type="file" name="Image" accept="@AdminRules.ImageAccept" data-preview-input="main" />
                    <i class="bi bi-image" aria-hidden="true"></i>
                    <span>@(hasMain ? "Replace the main image" : "Choose the main image")</span>
                    <small>Shown in the catalog. PNG, JPG or WEBP, up to 2 MB.</small>
                </label>
            </div>

            <div class="admin-card">
                <h2>Gallery <span class="admin-count">@Model.Images.Count / @AdminRules.MaxGallery</span></h2>
                <div class="admin-thumbs">
                    @foreach (var image in Model.Images)
                    {
                        var remove = Model.RemoveImages.Contains(image);
                        <figure class="admin-thumb@(remove ? " is-removed" : null)">
                            <img src="@ApiUrl.ToAbsolute(apiBase, image)" alt="" />
                            <figcaption>
                                @* Checkbox seçiləndə yadda saxlayanda şəkil silinir; o vaxta qədər geri qaytarmaq olar *@
                                <label class="admin-btn-sm is-danger admin-thumb-remove">
                                    <input type="checkbox" name="RemoveImages" value="@image" checked="@remove" data-remove-toggle />
                                    <i class="bi bi-trash" aria-hidden="true"></i>
                                    <span>@(remove ? "Undo" : "Remove")</span>
                                </label>
                            </figcaption>
                        </figure>
                    }
                </div>
                <div class="admin-thumbs" data-preview="gallery"></div>
                <label class="admin-drop">
                    <input type="file" name="Gallery" accept="@AdminRules.ImageAccept" multiple data-preview-input="gallery" />
                    <i class="bi bi-images" aria-hidden="true"></i>
                    <span>Add images to the gallery</span>
                    <small>Shown on the product page. Up to @AdminRules.MaxGallery images, 2 MB each.</small>
                </label>
            </div>
        </div>

        <div class="admin-stack">
            <div class="admin-card">
                <h2>Price and stock</h2>
                <p class="admin-note" data-variant-note hidden="@(!Model.HasVariants)">The price and stock come from the variants.</p>
                <div class="admin-form-grid" data-price-fields>
                    <label class="admin-field">
                        <span>Price, ₼</span>
                        <input name="Price" type="number" step="0.01" min="0.01" max="100000" value="@price" required disabled="@Model.HasVariants" />
                    </label>
                    <label class="admin-field">
                        <span>Old price, ₼</span>
                        <input name="OldPrice" type="number" step="0.01" min="0.01" max="100000" value="@oldPrice" placeholder="for Sale" disabled="@Model.HasVariants" />
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>Stock</span>
                        <input name="Stock" type="number" min="0" max="100000" value="@stock" required disabled="@Model.HasVariants" />
                    </label>
                </div>
                <p class="admin-note admin-note-top">A product that is in orders can't be deleted: set its stock to 0 instead.</p>
            </div>

            <div class="admin-card">
                <h2>Catalog</h2>
                <div class="admin-form-grid">
                    <label class="admin-field admin-field-wide">
                        <span>Category</span>
                        <select name="CategoryId" required>
                            <option value="">Choose a category</option>
                            @foreach (var category in Model.Categories)
                            {
                                <option value="@category.Id" selected="@(category.Id == Model.CategoryId)">@category.Name</option>
                            }
                        </select>
                    </label>
                    <label class="admin-field admin-field-wide">
                        <span>Badge</span>
                        <select name="Badge">
                            <option value="">None</option>
                            @foreach (var badge in ProductBadges.All)
                            {
                                <option value="@badge" selected="@(badge == Model.Badge)">@badge</option>
                            }
                        </select>
                        <small>"Coffee of the week" puts the product in that block on the home page.</small>
                    </label>
                </div>
                <div class="admin-field admin-field-wide admin-chips-field">
                    <span>Tags</span>
                    @if (Model.Tags.Count == 0)
                    {
                        <small>No tags yet.</small>
                    }
                    else
                    {
                        <div class="admin-chips">
                            @foreach (var tag in Model.Tags)
                            {
                                <label class="admin-chip">
                                    <input type="checkbox" name="TagIds" value="@tag.Id" checked="@Model.TagIds.Contains(tag.Id)" />
                                    <span>@tag.Name</span>
                                </label>
                            }
                        </div>
                    }
                    <small><a class="admin-link" asp-controller="Tags" asp-action="Index">Manage tags</a></small>
                </div>
            </div>

            <div class="admin-card">
                <label class="admin-check">
                    <input asp-for="IsVisible" type="checkbox" />
                    <span>Visible in the shop</span>
                </label>
                <div class="admin-form-actions">
                    <button type="submit" class="admin-btn">@(Model.IsNew ? "Create" : "Save")</button>
                    <a class="admin-btn is-ghost" asp-action="@(Model.IsNew ? "Index" : "Detail")" asp-route-id="@(Model.IsNew ? null : Model.Id)">Cancel</a>
                </div>
            </div>
        </div>
    </div>
</form>
