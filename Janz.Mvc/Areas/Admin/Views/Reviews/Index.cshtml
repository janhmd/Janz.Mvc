@model AdminReviewListVM
@{
    ViewData["Title"] = "Reviews";
    var filtered = Model.Type is not null || Model.Hidden is not null || Model.Search is not null;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Customers</p>
        <h1>Reviews <span>@Model.Reviews.Count</span></h1>
    </div>
    <div class="admin-head-actions">
        <form class="admin-search" method="get" asp-action="Index" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="search" value="@Model.Search" placeholder="Author, product or text" aria-label="Search reviews" />
            @if (Model.Type is not null)
            {
                <input type="hidden" name="type" value="@Model.Type" />
            }
        </form>
    </div>
</div>

<nav aria-label="Filter reviews">
    <div class="admin-filter">
        <a class="@(Model.Type is null && Model.Hidden is null ? "is-on" : null)" asp-action="Index" asp-route-search="@Model.Search">All</a>
        <a class="@(Model.Type == "product" ? "is-on" : null)" asp-action="Index" asp-route-type="product" asp-route-search="@Model.Search">Products</a>
        <a class="@(Model.Type == "shop" ? "is-on" : null)" asp-action="Index" asp-route-type="shop" asp-route-search="@Model.Search">Shop</a>
        <a class="@(Model.Hidden == true ? "is-on" : null)" asp-action="Index" asp-route-hidden="true">Hidden</a>
    </div>
</nav>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

@await Component.InvokeAsync("AdminReviewsTable", Model)
