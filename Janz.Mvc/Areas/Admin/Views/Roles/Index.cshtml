@model List<RoleVM>
@{
    ViewData["Title"] = "Roles";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Customers</p>
        <h1>Roles <span>@Model.Count</span></h1>
    </div>
</div>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

<div class="admin-card admin-card-flush">
    <div class="table-responsive">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Role</th>
                    <th>What it can do</th>
                    <th class="num">Users</th>
                    <th class="actions">Operations</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var role in Model)
                {
                    <tr>
                        <td>@role.Name</td>
                        <td>@role.Description</td>
                        <td class="num">@role.UserCount</td>
                        <td class="actions"><a class="admin-btn-sm" asp-controller="Users" asp-action="Index" asp-route-role="@role.Name">Users</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<p class="admin-note admin-note-top">A user's role is changed on their page in Users.</p>
