@model SettingsEditVM
@{
    ViewData["Title"] = "Settings";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">System</p>
        <h1>Settings</h1>
    </div>
</div>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

<form class="admin-form" method="post" asp-action="Index">
    <div asp-validation-summary="All" class="admin-errors" role="alert"></div>
    <div class="admin-card admin-form-narrow">
        <h2>Contacts</h2>
        <div class="admin-form-grid">
            <label class="admin-field"><span>Phone</span><input asp-for="Phone" required maxlength="30" /></label>
            <label class="admin-field"><span>Email</span><input asp-for="Email" type="email" required maxlength="100" /></label>
            <label class="admin-field admin-field-wide"><span>Address</span><input asp-for="Address" required maxlength="150" /></label>
            <label class="admin-field"><span>Instagram</span><input asp-for="Instagram" required maxlength="200" /></label>
            <label class="admin-field"><span>WhatsApp</span><input asp-for="WhatsApp" required maxlength="200" /></label>
            <label class="admin-field admin-field-wide"><span>Working hours</span><input asp-for="Hours" required maxlength="100" /></label>
        </div>
        <p class="admin-note admin-note-top">Shown in the footer on every page of the site.</p>
        <div class="admin-form-actions"><button type="submit" class="admin-btn">Save settings</button></div>
    </div>
</form>
