@model Janz.Mvc.ViewModels.Articles.ArticleEditVM
@using Janz.Mvc.ViewModels.Journal
@{
}

<div class="admin-stack">
    <div class="admin-card">
        <h2>Article</h2>
        <div class="admin-form-grid">
            <label class="admin-field admin-field-wide">
                <span>Title</span>
                <input asp-for="Title" required maxlength="200" />
            </label>
            <label class="admin-field admin-field-wide">
                <span>Lead</span>
                <textarea asp-for="Lead" rows="2" required maxlength="300"></textarea>
                <small>Shown on the card and under the title.</small>
            </label>
            <label class="admin-field admin-field-wide">
                <span>Text</span>
                <textarea asp-for="Body" rows="18" required></textarea>
                <small>An empty line starts a new paragraph. A line that starts with "## " is a heading. A line like [photo 2: caption] puts the 2nd image from the list below.</small>
            </label>
        </div>
    </div>

    <div class="admin-card">
        <h2>Cover</h2>
        @if (!string.IsNullOrEmpty(Model.CoverPath))
        {
            <div class="admin-thumbs">
                <figure class="admin-thumb is-main"><img src="@Model.CoverPath" alt="" /><figcaption><span class="admin-thumb-label">Cover</span></figcaption></figure>
            </div>
        }
        <div class="admin-thumbs" data-preview="main"></div>
        <label class="admin-drop">
            <input type="file" name="Cover" accept="@AdminRules.ImageAccept" data-preview-input="main" />
            <i class="bi bi-image" aria-hidden="true"></i>
            <span>Replace the cover</span>
            <small>Shown on the card and at the top of the article. PNG, JPG or WEBP, up to 2 MB.</small>
        </label>
    </div>

    <div class="admin-card">
        <h2>Images in the text</h2>
        <div class="admin-thumbs">
            @for (var i = 0; i < Model.CurrentImages.Count; i++)
            {
                var image = Model.CurrentImages[i];
                var remove = Model.RemoveImages.Contains(image);
                <figure class="admin-thumb@(remove ? " is-removed" : null)">
                    <img src="@image" alt="" />
                    <figcaption>
                        <span class="admin-thumb-label">[photo @(i + 1)]</span>
                        <label class="admin-btn-sm is-danger admin-thumb-remove">
                            <input type="checkbox" name="RemoveImages" value="@image" checked="@remove" data-remove-toggle />
                            <i class="bi bi-trash" aria-hidden="true"></i>
                            <span>@(remove ? "Undo" : "Remove")</span>
                        </label>
                    </figcaption>
                </figure>
            }
        </div>
        <div class="admin-thumbs" data-preview="gallery"></div>
        <label class="admin-drop">
            <input type="file" name="Images" accept="@AdminRules.ImageAccept" multiple data-preview-input="gallery" />
            <i class="bi bi-images" aria-hidden="true"></i>
            <span>Add images</span>
            <small>New images are added after the current ones: the first is [photo 1], the second is [photo 2] and so on.</small>
        </label>
    </div>
</div>
