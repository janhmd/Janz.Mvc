@model List<PageVM>
@{
}

<div class="admin-card admin-card-flush">
    @if (Model.Count == 0)
    {
        <p class="admin-empty admin-card-pad">No pages yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Page</th>
                        <th>Address</th>
                        <th>Linked from</th>
                        <th>Updated</th>
                        <th class="actions">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td><a asp-action="Edit" asp-route-id="@item.Id"><strong>@item.Title</strong></a></td>
                            <td><code>/Pages/@item.Slug</code></td>
                            <td>@(item.InTerms && item.InFooter ? "Header · Footer" : item.InTerms ? "Header" : item.InFooter ? "Footer" : "Not linked")</td>
                            <td>@item.UpdatedAt.ToLocalTime().ToString("dd.MM.yyyy")</td>
                            <td class="actions"><a class="admin-btn-sm" asp-action="Edit" asp-route-id="@item.Id">Edit</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
