@{
    // Menyu rola görədir (Helpers/AdminSections.cs): hər işçi yalnız öz bölmələrini görür
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var sections = AdminSections.For(User).ToList();
    var name = User.Identity?.Name ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Janz Admin</title>
    <link rel="stylesheet" href="~/admin/css/bootstrap.css" />
    <link rel="stylesheet" href="~/admin/vendors/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/admin/vendors/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/admin/css/app.css" />
    <link rel="stylesheet" href="~/admin/css/janz-admin.css" asp-append-version="true" />
    <script>if (localStorage.getItem("janz-theme") === "day") document.documentElement.classList.add("theme-day");</script>
</head>
<body>
    <div class="app">
        <div class="sidebar active">
            <div class="sidebar-wrapper active">
                <div class="sidebar-header">
                    <div class="d-flex justify-content-between align-items-center">
                        <a class="logo" aria-label="Janz admin" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">
                            <span class="logo-mark" aria-hidden="true">J</span>
                            <span class="logo-name">Janz</span>
                            <span class="logo-tag">Admin</span>
                        </a>
                        <div class="toggler">
                            <a href="#" class="sidebar-hide d-xl-none d-block" aria-label="Close menu"><i class="bi bi-x bi-middle"></i></a>
                        </div>
                    </div>
                </div>
                <div class="sidebar-menu">
                    <ul class="menu">
                        @foreach (var group in sections.GroupBy(m => m.Group))
                        {
                            <li class="sidebar-title">@group.Key</li>
                            @foreach (var item in group)
                            {
                                if (item.Controller is null)
                                {
                                    @* Hələ yazılmayan bölmə: görünür, amma açılmır *@
                                    <li class="sidebar-item is-soon">
                                        <span class="sidebar-link" aria-disabled="true">
                                            <i class="bi @item.Icon"></i>
                                            <span>@item.Title</span>
                                            <small class="admin-soon">soon</small>
                                        </span>
                                    </li>
                                }
                                else
                                {
                                    <li class="sidebar-item@(item.Controller == current ? " active" : null)">
                                        <a class="sidebar-link" asp-area="Admin" asp-controller="@item.Controller" asp-action="Index">
                                            <i class="bi @item.Icon"></i>
                                            <span>@item.Title</span>
                                        </a>
                                    </li>
                                }
                            }
                        }

                        <li class="sidebar-title">Account</li>
                        <li class="sidebar-item">
                            <a class="sidebar-link" href="/">
                                <i class="bi bi-shop"></i>
                                <span>Go to site</span>
                            </a>
                        </li>
                        <li class="sidebar-item">
                            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                <button type="submit" class="sidebar-link sidebar-button">
                                    <i class="bi bi-box-arrow-left"></i>
                                    <span>Sign out</span>
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </div>

        <div class="main">
            <header>
                <div class="admin-top">
                    <a href="#" class="burger-btn d-block d-xl-none" aria-label="Open menu"><i class="bi bi-list"></i></a>
                    <div class="admin-top-title">@ViewData["Title"]</div>
                    <button class="admin-theme" type="button" aria-label="Day mode"><i class="bi bi-sun"></i></button>
                    <div class="admin-user">
                        <span class="admin-avatar" aria-hidden="true">@name.Substring(0, 1).ToUpperInvariant()</span>
                        <div>
                            <div class="admin-user-name">@name</div>
                            <div class="admin-user-role">@AppRoles.MainRole(User)</div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="page-heading">
                @if (TempData["AdminSuccess"] is string success)
                {
                    <div class="admin-flash admin-flash-ok" role="status">@success</div>
                }
                @if (TempData["AdminError"] is string failure)
                {
                    <div class="admin-flash admin-flash-error" role="alert">@failure</div>
                }
                @RenderBody()
            </div>

            <footer>
                <div class="admin-footer">
                    <span>© 2026 Janz</span>
                    <span>Admin panel</span>
                </div>
            </footer>
        </div>
    </div>

    <div class="admin-assistant" data-summary="@Url.Action("Summary", "Assistant", new { area = "Admin" })">
        <button type="button" class="admin-assistant-toggle" aria-label="Admin assistant" aria-expanded="false">
            <i class="bi bi-stars" aria-hidden="true"></i>
        </button>
        <div class="admin-assistant-panel" role="dialog" aria-labelledby="admin-assistant-title" hidden>
            <div class="admin-assistant-head">
                <div>
                    <h2 id="admin-assistant-title">Admin assistant</h2>
                    <p>Shortcuts and answers for your work</p>
                </div>
                <button type="button" class="admin-assistant-close" aria-label="Close"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
            </div>
            <div class="admin-assistant-log" aria-live="polite"></div>
            <div class="admin-assistant-chips"></div>
            <form class="admin-assistant-form">
                <input name="question" placeholder="Type a section or a question" aria-label="Your question" maxlength="100" autocomplete="off" />
                <button type="submit" aria-label="Send"><i class="bi bi-arrow-right" aria-hidden="true"></i></button>
            </form>
            <nav class="admin-assistant-links" hidden>
                @foreach (var entry in sections.Where(m => m.Controller != null))
                {
                    <a href="@Url.Action("Index", entry.Controller, new { area = "Admin" })" data-title="@entry.Title">@entry.Title</a>
                }
                @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin))
                {
                    <a href="@Url.Action("Create", "Products", new { area = "Admin" })" data-title="Add product">Add product</a>
                    <a href="@Url.Action("Index", "Products", new { area = "Admin", lowStock = true })" data-title="Low stock">Low stock</a>
                }
                @if (User.IsInRole(AppRoles.SuperAdmin) || User.IsInRole(AppRoles.Admin) || User.IsInRole(AppRoles.Support))
                {
                    <a href="@Url.Action("Index", "Orders", new { area = "Admin", status = "Pending" })" data-title="Pending orders">Pending orders</a>
                }
            </nav>
        </div>
    </div>

    <script src="~/admin/vendors/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script src="~/admin/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/js/main.js"></script>
    <script src="~/admin/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
