@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    // Menyu rola görədir (Helpers/AdminSections.cs): hər işçi yalnız öz bölmələrini görür
    var current = ViewContext.RouteData.Values["controller"]?.ToString();
    var sections = AdminSections.For(User).ToList();
    var name = User.Identity?.Name ?? "Admin";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Janz Admin</title>
    <link rel="stylesheet" href="~/admin/css/bootstrap.css" />
    <link rel="stylesheet" href="~/admin/vendors/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/admin/vendors/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/admin/css/app.css" />
    <link rel="stylesheet" href="~/admin/css/janz-admin.css" asp-append-version="true" />
    <script>if (localStorage.getItem("janz-theme") === "day") document.documentElement.classList.add("theme-day");</script>
</head>
<body>
    <div class="app">
        @await Component.InvokeAsync("AdminSidebar")

        <div class="main">
            <header>
                <div class="admin-top">
                    <a href="#" class="burger-btn d-block d-xl-none" aria-label="Open menu"><i class="bi bi-list"></i></a>
                    <div class="admin-top-title">@ViewData["Title"]</div>
                    <button class="admin-theme" type="button" aria-label="Day mode"><i class="bi bi-sun"></i></button>
                    <div class="admin-user">
                        <span class="admin-avatar" aria-hidden="true">@name.Substring(0, 1).ToUpperInvariant()</span>
                        <div>
                            <div class="admin-user-name">@name</div>
                            <div class="admin-user-role">@AppRoles.MainRole(User)</div>
                        </div>
                    </div>
                </div>
            </header>

            <div class="page-heading">
                @if (TempData["AdminSuccess"] is string success)
                {
                    <div class="admin-flash admin-flash-ok" role="status">@success</div>
                }
                @if (TempData["AdminError"] is string failure)
                {
                    <div class="admin-flash admin-flash-error" role="alert">@failure</div>
                }
                @RenderBody()
            </div>

            <footer>
                <div class="admin-footer">
                    <span>© @DateTime.Now.Year Janz</span>
                    <span>Admin panel</span>
                </div>
            </footer>
        </div>
    </div>

    @await Component.InvokeAsync("AdminAssistant")

    <script src="~/admin/vendors/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script src="~/admin/js/bootstrap.bundle.min.js"></script>
    <script src="~/admin/js/main.js"></script>
    <script src="~/admin/js/admin.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
