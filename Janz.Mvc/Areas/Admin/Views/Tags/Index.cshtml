@model Janz.Mvc.ViewModels.Tags.TagListVM
@{
    ViewData["Title"] = "Tags";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Shop</p>
        <h1>Tags <span>@Model.Tags.Count</span></h1>
    </div>
    <form class="admin-inline-form" method="post" asp-action="Create">
        <input name="name" value="@Model.NewName" placeholder="New tag" aria-label="New tag" required maxlength="100" />
        <button type="submit" class="admin-btn"><i class="bi bi-plus"></i> Add tag</button>
    </form>
</div>

<div asp-validation-summary="All" class="admin-errors" role="alert"></div>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

@await Component.InvokeAsync("AdminTagsTable", Model)
