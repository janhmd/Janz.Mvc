@model Janz.Mvc.ViewModels.Tags.TagListVM
@{
    ViewData["Title"] = "Tags";
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Shop</p>
        <h1>Tags <span>@Model.Tags.Count</span></h1>
    </div>
    <form class="admin-inline-form" method="post" asp-action="Create">
        <input name="name" value="@Model.NewName" placeholder="New tag" aria-label="New tag" required maxlength="100" />
        <button type="submit" class="admin-btn"><i class="bi bi-plus"></i> Add tag</button>
    </form>
</div>

<div asp-validation-summary="All" class="admin-errors" role="alert"></div>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

<div class="admin-card admin-card-flush">
    @if (Model.Tags.Count == 0)
    {
        <p class="admin-empty">No tags yet.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th class="num">Id</th>
                        <th>Name</th>
                        <th>Slug</th>
                        <th class="num">Products</th>
                        <th class="actions">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var tag in Model.Tags)
                    {
                        var formId = "tag-" + tag.Id;
                        var name = Model.EditedId == tag.Id ? Model.EditedName : tag.Name;
                        <tr>
                            <td class="num">@tag.Id</td>
                            @* Ad sahəsi cədvəldədir, forma isə Operations sütununda: form="..." onları bağlayır *@
                            <td><input class="admin-cell-input" form="@formId" name="name" value="@name" aria-label="Tag name" required maxlength="100" /></td>
                            <td><code>@tag.Slug</code></td>
                            <td class="num">@tag.ProductCount</td>
                            <td class="actions">
                                <span class="admin-actions">
                                    <form id="@formId" method="post" asp-action="Update" asp-route-id="@tag.Id">
                                        <button type="submit" class="admin-btn-sm">Save</button>
                                    </form>
                                    <form method="post" asp-action="Delete" asp-route-id="@tag.Id" data-confirm="Delete the tag @tag.Name? Products keep their other tags.">
                                        <button type="submit" class="admin-btn-sm is-danger">Delete</button>
                                    </form>
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
