@model UserListVM
@{
    ViewData["Title"] = "Users";
    var filtered = Model.Role is not null || Model.Blocked is not null || Model.Search is not null;
}

<div class="admin-head">
    <div>
        <p class="admin-eyebrow">Customers</p>
        <h1>Users <span>@Model.Users.Count</span></h1>
    </div>
    <div class="admin-head-actions">
        <form class="admin-search" method="get" asp-action="Index" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" name="search" value="@Model.Search" placeholder="Name or email" aria-label="Search users" />
            @if (Model.Role is not null)
            {
                <input type="hidden" name="role" value="@Model.Role" />
            }
        </form>
    </div>
</div>

<nav aria-label="Filter users">
    <div class="admin-filter">
        <a class="@(!filtered || (Model.Role is null && Model.Blocked is null) ? "is-on" : null)" asp-action="Index" asp-route-search="@Model.Search">All</a>
        @foreach (var role in Janz.Mvc.Areas.Admin.Controllers.UsersController.Roles)
        {
            <a class="@(Model.Role == role ? "is-on" : null)" asp-action="Index" asp-route-role="@role" asp-route-search="@Model.Search">@role</a>
        }
        <a class="@(Model.Blocked == true ? "is-on" : null)" asp-action="Index" asp-route-blocked="true">Blocked</a>
    </div>
</nav>

@if (ViewBag.Error is string error)
{
    <div class="admin-flash admin-flash-error" role="alert">@error</div>
}

@await Component.InvokeAsync("AdminUsersTable", Model)
