@model Janz.Mvc.ViewModels.Account.LoginVM
@{
    ViewData["Title"] = "Sign in";
}

<main>        <section id="signin">
            <div class="entry-card">
                <h1>Sign in</h1>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
                    @foreach (var error in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                    {
                        <p class="entry-error">@error.ErrorMessage</p>
                    }
                    <label class="entry-field">
                        <input type="email" name="email" placeholder="Email" autocomplete="email" value="@Model.Email" required />
                    </label>
                    <label class="entry-field">
                        <input type="password" name="password" placeholder="Password" autocomplete="current-password" required />
                        <button type="button" class="entry-eye" aria-label="Show password">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12s3.6-6.5 9-6.5S21 12 21 12s-3.6 6.5-9 6.5S3 12 3 12z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                        </button>
                    </label>
                    <button type="submit" class="account-signin">Sign in</button>
                    <a class="entry-forgot" href="#">Forgot password?</a>
                    <label class="entry-remember">
                        <input type="checkbox" name="remember" value="true" checked="@Model.Remember" />
                        Remember password
                    </label>
                </form>
            </div>
        </section>    </main>
