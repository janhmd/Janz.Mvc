@model Janz.Mvc.ViewModels.Account.ResetPasswordVM
@{
    ViewData["Title"] = "New password";
}

<main>
        <section id="reset">
            <div class="entry-card">
                <h1>New password</h1>
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    <input type="hidden" name="userId" value="@Model.UserId" />
                    <input type="hidden" name="token" value="@Model.Token" />
                    @foreach (var error in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                    {
                        <p class="entry-error">@error.ErrorMessage</p>
                    }
                    <label>
                        <span class="entry-caption">Email</span>
                        <span class="entry-field">
                            <input type="email" name="email" value="@Model.Email" placeholder="Your email" autocomplete="email" required />
                        </span>
                    </label>
                    <label>
                        <span class="entry-caption">New password</span>
                        <span class="entry-field">
                            <input type="password" name="password" placeholder="Password" autocomplete="new-password" minlength="6" required />
                            <button type="button" class="entry-eye" aria-label="Show password">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12s3.6-6.5 9-6.5S21 12 21 12s-3.6 6.5-9 6.5S3 12 3 12z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                            </button>
                        </span>
                    </label>
                    <label>
                        <span class="entry-caption">Repeat</span>
                        <span class="entry-field">
                            <input type="password" name="repeatPassword" placeholder="Password" autocomplete="new-password" minlength="6" required />
                            <button type="button" class="entry-eye" aria-label="Show password">
                                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12s3.6-6.5 9-6.5S21 12 21 12s-3.6 6.5-9 6.5S3 12 3 12z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                            </button>
                        </span>
                    </label>
                    <button type="submit" class="account-signin">Save the password</button>
                    <a class="entry-link" asp-action="ForgotPassword">Request a new link</a>
                </form>
            </div>
        </section>
    </main>
