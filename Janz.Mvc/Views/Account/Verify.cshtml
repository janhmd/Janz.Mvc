@model Janz.Mvc.ViewModels.Account.VerifyVM
@{
    ViewData["Title"] = "Confirm your email";
}

<main>
        <section id="verify">
            <div class="entry-card">
                <h1>Check your email</h1>
                <form asp-controller="Account" asp-action="Verify" method="post">
                    @if (TempData["AccountDone"] is string done)
                    {
                        <p class="entry-done">@done</p>
                    }
                    @foreach (var error in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                    {
                        <p class="entry-error">@error.ErrorMessage</p>
                    }
                    <p class="entry-text">We sent a 4-digit code to <strong>@Model.Email</strong>. Enter it to finish the registration and sign in.</p>
                    <input type="hidden" name="email" value="@Model.Email" />
                    <label>
                        <span class="entry-caption">Code</span>
                        <span class="entry-field entry-code">
                            <input type="text" name="code" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="one-time-code" placeholder="0000" required autofocus />
                        </span>
                    </label>
                    <button type="submit" class="account-signin">Confirm</button>
                </form>
                <form asp-controller="Account" asp-action="ResendCode" method="post">
                    <input type="hidden" name="email" value="@Model.Email" />
                    <p class="entry-text">Didn't get the email? Check the spam folder or send the code again.</p>
                    <button type="submit" class="entry-link">Send the code again</button>
                    <a class="entry-link" asp-action="Login">Back to sign in</a>
                </form>
            </div>
        </section>
    </main>
