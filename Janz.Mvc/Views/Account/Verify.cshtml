@model Janz.Mvc.ViewModels.Account.AccountEmailVM
@{
    ViewData["Title"] = "Confirm your email";
}

<main>
        <section id="verify">
            <div class="entry-card">
                <h1>Check your email</h1>
                <form asp-controller="Account" asp-action="Verify" method="post">
                    @if (TempData["AccountDone"] is string done)
                    {
                        <p class="entry-done">@done</p>
                    }
                    @foreach (var error in ViewData.ModelState[string.Empty]?.Errors ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
                    {
                        <p class="entry-error">@error.ErrorMessage</p>
                    }
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <p class="entry-text">We sent a confirmation link to <strong>@Model.Email</strong>. Open it to finish the registration and sign in.</p>
                    }
                    <p class="entry-text">Didn't get the email? Check the spam folder or send the link again.</p>
                    <label>
                        <span class="entry-caption">Email</span>
                        <span class="entry-field">
                            <input type="email" name="email" autocomplete="email" value="@Model.Email" required />
                        </span>
                    </label>
                    <button type="submit" class="account-signin">Send the link again</button>
                    <a class="entry-link" asp-action="Login">Back to sign in</a>
                </form>
            </div>
        </section>
    </main>
