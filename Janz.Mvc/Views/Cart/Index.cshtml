@using Janz.Mvc.Helpers
@using System.Globalization
@model Janz.Mvc.ViewModels.Cart.CartPageVM
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Cart";
    var error = TempData["CartError"] as string;
    var addressError = TempData["AddressError"] as string;
    var apiBase = Configuration["ApiSettings:BaseUrl"];
    var en = CultureInfo.GetCultureInfo("en-US");
    var today = DateTime.Today;
    string Day(int days) => today.AddDays(days).ToString("d MMMM", en);
    var hasItems = Model.Cart.Items.Count > 0;
    var selected = Model.Addresses.FirstOrDefault(m => m.Id == Model.SelectedAddressId);
}

<main>
    <section id="cart">
        @if (!hasItems)
        {
            @await Component.InvokeAsync("CartEmpty", Model)
        }
        else
        {
            @await Component.InvokeAsync("CartCheckout", Model)

            @await Component.InvokeAsync("CartExtraForms", Model)
        }

        @if (!hasItems)
        {
            @await Component.InvokeAsync("CartSuggestions", Model)
        }
    </section>
</main>
