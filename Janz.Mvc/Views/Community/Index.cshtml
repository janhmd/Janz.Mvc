        document.querySelectorAll(".community-tabs button").forEach(function (tab) {
            tab.addEventListener("click", function () {
                document.querySelectorAll(".community-tabs button").forEach(function (item) {
                    item.classList.toggle("is-on", item === tab);
                    item.setAttribute("aria-pressed", item === tab ? "true" : "false");
                });
            });
        });
