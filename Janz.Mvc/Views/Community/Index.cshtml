@model Janz.Mvc.ViewModels.Community.CommunityPageVM
@{
    ViewData["Title"] = "Community";
    var signedIn = User.Identity?.IsAuthenticated == true;
}

<main>
        <section id="community">
            <div class="community-wrap">
                <div class="community-bar">
                    <h1>Community</h1>
                    <div class="community-tabs">
                        <a href="/Community?tab=best" class="@(Model.Tab == "best" && Model.Tag is null ? "is-on" : "")">Best</a>
                        <a href="/Community?tab=new" class="@(Model.Tab == "new" && Model.Tag is null ? "is-on" : "")">New</a>
                        <button type="button" data-channels class="@(Model.Tag is not null ? "is-on" : "")" aria-pressed="@(Model.Tag is not null ? "true" : "false")">Channels</button>
                    </div>
                </div>

                <div class="community-channels" @(Model.Tag is null ? "hidden" : null)>
                    @foreach (var tag in Model.Tags)
                    {
                        <a href="/Community?tag=@Uri.EscapeDataString(tag)" class="@(string.Equals(Model.Tag, tag, StringComparison.OrdinalIgnoreCase) ? "is-on" : "")"><span>#</span> @tag</a>
                    }
                </div>

                <form method="get" action="/Community">
                    <input type="hidden" name="tab" value="@Model.Tab" />
                    <label class="community-search">
                        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                        <input type="search" name="search" value="@Model.Search" placeholder="Search" />
                        <select name="scope" aria-label="Search where">
                            <option value="everywhere" selected="@(Model.Scope == "everywhere")">Everywhere</option>
                            <option value="posts" selected="@(Model.Scope == "posts")">Posts</option>
                            <option value="comments" selected="@(Model.Scope == "comments")">Comments</option>
                        </select>
                    </label>
                </form>

                @if (!signedIn)
                {
                    <p class="community-note">To leave a comment, <a href="/Account/Login">sign in</a> to your account or <a href="/Account/Register">register</a>.</p>
                }

                <div class="feed">
                    @foreach (var post in Model.Posts)
                    {
                        <partial name="_FeedCard" model="post" />
                    }
                    @if (Model.Posts.Count == 0)
                    {
                        <p class="feed-empty">No posts here yet.</p>
                    }
                </div>
            </div>
        </section>
    </main>
