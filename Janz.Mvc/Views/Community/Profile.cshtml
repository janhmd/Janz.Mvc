@model Janz.Mvc.ViewModels.Community.CommunityProfileUIVM
@{
    var author = Model.Author;
    ViewData["Title"] = author.Name;
    var initial = string.IsNullOrWhiteSpace(author.Name) ? "C" : author.Name.Substring(0, 1).ToUpper();
    var span = DateTime.UtcNow - Model.Stats.MemberSince.ToUniversalTime();
    var months = Math.Max(0, (int)(span.TotalDays / 30.4));
    var onSite = months >= 12 ? $"{months / 12} {(months / 12 == 1 ? "year" : "years")} {months % 12} {(months % 12 == 1 ? "month" : "months")}" : $"{months} {(months == 1 ? "month" : "months")}";
}

<main>
    <section id="user-profile" data-user-id="@author.UserId">
        <h1>User profile</h1>
        <div class="up-grid">
            <div class="up-side">
                <div class="up-person">
                    <div class="feed-avatar">@if (!string.IsNullOrEmpty(author.AvatarPath)){<img src="@author.AvatarPath" alt="" />}else{<span>@initial</span>}</div>
                    <div class="up-who">
                        <b>@author.Name</b>@if (!string.IsNullOrEmpty(author.StaffRole)){<span class="staff-badge">@author.StaffRole</span>}
                        <span>@author.Role</span>
                    </div>
                    <button type="button" class="up-share" aria-label="Share profile">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 14V3.8m0 0L8.6 7.2M12 3.8l3.4 3.4M8 10.5H6.2A1.2 1.2 0 0 0 5 11.7v7.1A1.2 1.2 0 0 0 6.2 20h11.6a1.2 1.2 0 0 0 1.2-1.2v-7.1a1.2 1.2 0 0 0-1.2-1.2H16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>
                </div>
                <div class="up-follow-row">
                    <div class="up-tile"><b data-followers>@Model.Followers</b><span>followers</span></div>
                    <div class="up-tile"><b>@Model.Following</b><span>following</span></div>
                </div>
                @if (!Model.IsMe)
                {
                    <button type="button" class="up-follow@(Model.IsFollowing ? " is-on" : "")" aria-pressed="@(Model.IsFollowing ? "true" : "false")">@(Model.IsFollowing ? "Following" : "Follow")</button>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    <div class="up-bio">
                        <p>@Model.Bio</p>
                    </div>
                }
                <ul class="up-stats">
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="13" r="7" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 9.5V13l2 1.6M10 3h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>On the site <span>@onSite</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>Orders placed <span>@Model.Stats.Orders</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="7.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M8.5 15.5l7-7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Tried <span>@Model.Stats.TriedCoffees @(Model.Stats.TriedCoffees == 1 ? "coffee" : "different coffees")</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>Average coffee rating <span>@(Model.Stats.AverageRating > 0 ? Model.Stats.AverageRating.ToString("0.0") : "-")</span></li>
                    <li class="up-gap"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>Comments <span>@Model.Stats.Comments</span></li>
                    <li><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11v9H5.2A1.2 1.2 0 0 1 4 18.8v-6.6A1.2 1.2 0 0 1 5.2 11zm0 0l3.6-6.6a1.8 1.8 0 0 1 3.3 1.3L14 10h4.4a1.6 1.6 0 0 1 1.6 1.9l-1.3 6.6A1.8 1.8 0 0 1 17 20H8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>Likes received <span>@Model.Stats.LikesReceived</span></li>
                </ul>
            </div>
            <div class="feed up-feed">
                @foreach (var post in Model.Posts)
                {
                    <partial name="_FeedCard" model="post" />
                }
                @if (Model.Posts.Count == 0)
                {
                    <p class="feed-empty">@(Model.IsBlocked ? "You blocked this user." : "No posts yet.")</p>
                }
            </div>
            @if (Model.CookMethods.Count > 0)
            {
                <div class="up-right">
                    <h2 class="up-brew-title">How I cook</h2>
                    @foreach (var method in Model.CookMethods)
                    {
                        <a class="up-brew" href="/Community?search=@Uri.EscapeDataString(method)&scope=posts">
                            <span><b>@method</b><em>See posts</em></span>
                        </a>
                    }
                </div>
            }
        </div>
    </section>
</main>
