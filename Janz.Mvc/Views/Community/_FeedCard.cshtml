@model Janz.Mvc.ViewModels.Community.PostUIVM
@{
    var author = Model.Author;
    var slug = string.IsNullOrWhiteSpace(author.Nickname) ? author.UserId : author.Nickname;
    var initial = string.IsNullOrWhiteSpace(author.Name) ? "C" : author.Name.Substring(0, 1).ToUpper();
    var signedIn = User.Identity?.IsAuthenticated == true;
    var paragraphs = Model.Text.Split('\n', StringSplitOptions.RemoveEmptyEntries);
}
<div class="feed-card" id="post-@Model.Id" data-post-id="@Model.Id" data-user-id="@author.UserId" data-mine="@(Model.IsMine ? "1" : "0")">
    <div class="feed-head">
        <div class="feed-avatar">@if (!string.IsNullOrEmpty(author.AvatarPath)){<img src="@author.AvatarPath" alt="" />}else{<span>@initial</span>}<i class="feed-badge"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="9" cy="10" r="1.1" fill="currentColor"/><circle cx="15" cy="10" r="1.1" fill="currentColor"/><path d="M8.4 14c.9 1.3 2.1 2 3.6 2s2.7-.7 3.6-2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></i></div>
        <div class="feed-who">
            <div class="feed-name">
                <a href="/Community/Profile/@Uri.EscapeDataString(slug)">@author.Name</a>
                @if (!Model.IsMine)
                {
                    <button type="button" class="feed-follow@(Model.IsFollowing ? " is-on" : "")" aria-pressed="@(Model.IsFollowing ? "true" : "false")">@(Model.IsFollowing ? "Following" : "Follow")</button>
                }
            </div>
            <div class="feed-role">@author.Role</div>
        </div>
        <time class="feed-date">@Model.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy")</time>
        <button type="button" class="feed-more" aria-label="More"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="5.5" r="1.6" fill="currentColor"/><circle cx="12" cy="12" r="1.6" fill="currentColor"/><circle cx="12" cy="18.5" r="1.6" fill="currentColor"/></svg></button>
    </div>
    <div class="feed-text">
        @foreach (var paragraph in paragraphs)
        {
            <p>@paragraph</p>
        }
    </div>
    @if (Model.Images.Count > 0)
    {
        <div class="feed-photos" data-feed-photos>
            <div class="feed-frame">
                <div class="feed-track">
                    @foreach (var image in Model.Images)
                    {
                        <img src="@image" alt="" draggable="false" />
                    }
                </div>
            </div>
            @if (Model.Images.Count > 1)
            {
                <div class="feed-dots">
                    @for (var i = 0; i < Model.Images.Count; i++)
                    {
                        <button type="button" class="@(i == 0 ? "is-on" : "")" aria-label="Photo @(i + 1)"></button>
                    }
                </div>
            }
        </div>
    }
    @if (Model.Product is not null)
    {
        <a class="feed-product" href="/Products/Detail/@Model.Product.Id">
            <img src="@Model.Product.ImagePath" alt="" />
            <span>@Model.Product.Name</span>
        </a>
    }
    @if (Model.Rating.HasValue || !string.IsNullOrWhiteSpace(Model.Brew) || !string.IsNullOrWhiteSpace(Model.Recipe) || !string.IsNullOrWhiteSpace(Model.Dose) || !string.IsNullOrWhiteSpace(Model.Water) || !string.IsNullOrWhiteSpace(Model.Grind) || !string.IsNullOrWhiteSpace(Model.Time))
    {
        <dl class="feed-recipe">
            @if (Model.Rating.HasValue){<div><dt>Rating</dt><dd>@Model.Rating / 5</dd></div>}
            @if (!string.IsNullOrWhiteSpace(Model.Brew)){<div><dt>Brew</dt><dd>@Model.Brew</dd></div>}
            @if (!string.IsNullOrWhiteSpace(Model.Dose)){<div><dt>Dose</dt><dd>@Model.Dose</dd></div>}
            @if (!string.IsNullOrWhiteSpace(Model.Water)){<div><dt>Water</dt><dd>@Model.Water</dd></div>}
            @if (!string.IsNullOrWhiteSpace(Model.Grind)){<div><dt>Grind</dt><dd>@Model.Grind</dd></div>}
            @if (!string.IsNullOrWhiteSpace(Model.Time)){<div><dt>Time</dt><dd>@Model.Time</dd></div>}
            @if (!string.IsNullOrWhiteSpace(Model.Recipe)){<div class="is-wide"><dt>Recipe</dt><dd>@Model.Recipe</dd></div>}
        </dl>
    }
    @if (Model.Tags.Count > 0)
    {
        <div class="feed-tags">
            @foreach (var tag in Model.Tags)
            {
                <a href="/Community?tag=@Uri.EscapeDataString(tag)"><span>#</span> @tag</a>
            }
        </div>
    }
    <div class="feed-actions">
        <button type="button" class="feed-like@(Model.MyVote == 1 ? " is-on" : "")" aria-label="Like" aria-pressed="@(Model.MyVote == 1 ? "true" : "false")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8 11v9H5.2A1.2 1.2 0 0 1 4 18.8v-6.6A1.2 1.2 0 0 1 5.2 11H8zm0 0l3.2-6.1A2.2 2.2 0 0 1 13.2 4h.3A2.5 2.5 0 0 1 16 6.5V11h3.7a1.8 1.8 0 0 1 1.8 2.1l-1.2 6.2A1.8 1.8 0 0 1 18.5 21H8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></button>
        <span class="feed-score">@Model.Score</span>
        <button type="button" class="feed-dislike@(Model.MyVote == -1 ? " is-on" : "")" aria-label="Dislike" aria-pressed="@(Model.MyVote == -1 ? "true" : "false")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M16 13V4h2.8A1.2 1.2 0 0 1 20 5.2v6.6A1.2 1.2 0 0 1 18.8 13H16zm0 0l-3.2 6.1a2.2 2.2 0 0 1-2 1.2h-.3A2.5 2.5 0 0 1 8 17.8V13H4.3a1.8 1.8 0 0 1-1.8-2.1l1.2-6.2A1.8 1.8 0 0 1 5.5 3H16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></button>
        <button type="button" class="feed-comments" aria-label="Comments" aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 4.5c4.4 0 8 2.9 8 6.6s-3.6 6.6-8 6.6c-.9 0-1.8-.1-2.6-.3L5 19.5l1.2-3.6C4.8 14.7 4 13 4 11.1 4 7.4 7.6 4.5 12 4.5z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg><span>@Model.CommentCount</span></button>
        <button type="button" class="feed-share push" aria-label="Share"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 14V3.8m0 0L8.6 7.2M12 3.8l3.4 3.4M8 10.5H6.2A1.2 1.2 0 0 0 5 11.7v7.1A1.2 1.2 0 0 0 6.2 20h11.6a1.2 1.2 0 0 0 1.2-1.2v-7.1a1.2 1.2 0 0 0-1.2-1.2H16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
        <button type="button" class="feed-save@(Model.IsSaved ? " is-on" : "")" aria-label="Save" aria-pressed="@(Model.IsSaved ? "true" : "false")"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 4.5h10v15l-5-3.4-5 3.4z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></button>
    </div>
    <div class="feed-thread" hidden>
        @foreach (var comment in Model.Comments)
        {
            <partial name="_FeedNote" model="comment" />
        }
        <p class="feed-thread-empty" hidden="@(Model.Comments.Count > 0)">No comments yet. Be the first.</p>
    </div>
    <form class="feed-comment">
        <label class="feed-comment-field">
            <input type="text" name="comment" placeholder="Write a comment" autocomplete="off" maxlength="1000" />
            <span class="feed-comment-photo" aria-label="Attach photo"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 8.2A1.7 1.7 0 0 1 5.7 6.5h2.1l1.4-2h5.6l1.4 2h2.1A1.7 1.7 0 0 1 20 8.2v9.1a1.7 1.7 0 0 1-1.7 1.7H5.7A1.7 1.7 0 0 1 4 17.3z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><circle cx="12" cy="12.6" r="3.3" fill="none" stroke="currentColor" stroke-width="1.6"/></svg><input type="file" name="photo" accept="image/*" /></span>
        </label>
        <button type="submit" class="feed-comment-send" aria-label="Send"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19.5V5m0 0l-5.2 5.2M12 5l5.2 5.2" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </form>
</div>
