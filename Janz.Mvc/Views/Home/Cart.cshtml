@model Janz.Mvc.ViewModels.Cart.CartPageVM
@{
    ViewData["Title"] = "Cart";
    var error = TempData["CartError"] as string;
}

<main>
        <section id="cart">
            @if (Model.Cart.Items.Count == 0)
            {
                <div class="wish-empty cart-empty">
                    <h1>The cart is empty</h1>
                    <p>Let’s pick something in the catalog</p>
                    <a href="/Home/Catalog">To catalog</a>
                </div>
            }
            else
            {
                <h1 class="cart-title">Cart <span>@Model.Cart.Count pcs</span></h1>
                @if (!string.IsNullOrEmpty(error))
                {
                    <p class="entry-error">@error</p>
                }
                <div class="cart-lines">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <div class="cart-line">
                            <a class="cart-line-photo" href="/Home/Product/@item.ProductId"><img src="@item.ImagePath" alt="@item.ProductName" /></a>
                            <div class="cart-line-info">
                                <a href="/Home/Product/@item.ProductId">@item.ProductName</a>
                                <div class="kind">₼@item.Price.ToString("0.00") · @item.Stock in stock</div>
                            </div>
                            <div class="cart-qty">
                                <form asp-controller="Home" asp-action="UpdateCart" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="quantity" value="@(item.Quantity - 1)" />
                                    <button type="submit" aria-label="Less" disabled="@(item.Quantity <= 1)">−</button>
                                </form>
                                <span>@item.Quantity</span>
                                <form asp-controller="Home" asp-action="UpdateCart" method="post">
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <input type="hidden" name="quantity" value="@(item.Quantity + 1)" />
                                    <button type="submit" aria-label="More" disabled="@(item.Quantity >= item.Stock)">+</button>
                                </form>
                            </div>
                            <strong class="cart-line-total">₼@item.Total.ToString("0.00")</strong>
                            <form asp-controller="Home" asp-action="RemoveFromCart" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <button type="submit" class="cart-remove" aria-label="Remove">×</button>
                            </form>
                        </div>
                    }
                </div>
                <div class="cart-sum">
                    <span>Total</span>
                    <strong>₼@Model.Cart.Total.ToString("0.00")</strong>
                    @if (Model.Addresses.Count == 0)
                    {
                        @* Ünvan olmadan sifariş olmur: əvvəl Account → My details-də ünvan əlavə edilir *@
                        <a class="cart-place" href="/Home/Account#details">Add a delivery address</a>
                    }
                    else
                    {
                        <form class="cart-checkout" asp-controller="Home" asp-action="PlaceOrder" method="post">
                            <label class="cart-address">
                                <span>Deliver to</span>
                                <select name="addressId" required>
                                    @foreach (var address in Model.Addresses)
                                    {
                                        <option value="@address.Id">@address.FullName · @address.Line, @address.City</option>
                                    }
                                </select>
                            </label>
                            <button type="submit" class="cart-place">Place order</button>
                        </form>
                    }
                </div>
            }

            <h2 class="cart-like">You might like</h2>
            <div class="card-grid">
                @foreach (var product in Model.Suggestions)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </section>
    </main>
