@{
    ViewData["Title"] = "Chocolate and syrups";
}

<main>        <section id="chocolate">
            <h1>Chocolate and syrups</h1>
            <div class="gear-row">
                <a class="catalog-tile" href="#"><video muted loop playsinline preload="metadata" src="/videos/choc-bars.mp4"></video><span>Chocolate bars</span></a>
                <a class="catalog-tile" href="#"><video muted loop playsinline preload="metadata" src="/videos/choc-shavings.mp4"></video><span>Chocolate shavings</span></a>
                <a class="catalog-tile" href="#"><video muted loop playsinline preload="metadata" src="/videos/choc-syrup.mp4"></video><span>Syrups</span></a>
                <a class="catalog-tile" href="#"><video muted loop playsinline preload="metadata" src="/videos/choc-dry-syrup.mp4"></video><span>Dry syrups</span></a>
                <a class="catalog-tile" href="#"><video muted loop playsinline preload="metadata" src="/videos/choc-dry-base.mp4"></video><span>Dry bases</span></a>
            </div>
            <label class="listing-sort">
                <select aria-label="Sort">
                    <option value="" selected>Sort</option>
                    <option value="popular">Popular</option>
                    <option value="new">New</option>
                    <option value="price-asc">Price, low to high</option>
                    <option value="price-desc">Price, high to low</option>
                    <option value="rating">Rating</option>
                </select>
            </label>
        </section>    </main>
