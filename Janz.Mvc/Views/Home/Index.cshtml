@model HomeIndexVM
@{
    ViewData["Title"] = "Home";
    var week = Model.Coffee.Take(2).ToList();
    var fresh = Model.Coffee.Skip(2).Take(4).ToList();
    var popular = Model.Coffee.Skip(6).ToList();
}

<main>
        <section id="hero">
            <h1>Every day we roast coffee and<br>deliver for free all over Azerbaijan</h1>
            <div class="hero-row">
                <a class="shot" href="/Products">
                    <video muted loop playsinline preload="metadata" src="/videos/espresso.mp4"></video>
                    <span>Coffee</span>
                    <small>@Model.Coffee.Count</small>
                </a>
                <a class="shot" href="/Products/Chocolate">
                    <video muted loop playsinline preload="metadata" src="/videos/choc-syrup.mp4"></video>
                    <span>Syrups</span>
                </a>
                <a class="shot" href="/Products/Tea">
                    <video muted loop playsinline preload="metadata" src="/videos/tea.mp4"></video>
                    <span>Tea</span>
                </a>
                <aside>
                    <div class="account-card">
                        <div class="account-title">Sign in, and it gets cheaper</div>
                        <div class="account-note">More discounts in your account</div>
                        <a class="account-signin" href="/Account/Login">Sign in</a>
                        <a class="account-register" href="/Account/Register">Register</a>
                    </div>
                </aside>
            </div>
        </section>

        <section id="week">
            <h2>Coffees of the week <span>on sale</span></h2>
            <div class="week-row">
                @foreach (var product in week)
                {
                    <partial name="_ProductCard" model="product" />
                }
                <aside>
                    <div class="roast-card">
                        <div class="roast-track">
                            <div class="roast-slide">
                                <img src="/images/roast.png" alt="Coffee beans in the roaster" />
                                <div class="roast-copy">
                                    <div class="line-light">Until the next roast</div>
                                    <div class="line-bold">1 day 15 hours</div>
                                    <div class="line-bold">We deliver</div>
                                    <div class="line-light">for free</div>
                                    <div class="line-bold">We'll refund the money,</div>
                                    <div class="line-light">if you don't like the coffee</div>
                                </div>
                            </div>
                            <div class="roast-slide">
                                <img src="/images/journal.png" alt="Barista pouring coffee" />
                                <div class="roast-copy">
                                    <div class="line-light">Coffee journal</div>
                                    <div class="line-bold">What's in plant milk: what can be a red flag for a barista and guests</div>
                                    <a class="read-article" href="#">Read the article</a>
                                </div>
                            </div>
                            <div class="roast-slide">
                                <img src="/images/aroma-kit.png" alt="Coffee aroma kit" />
                                <div class="roast-copy">
                                    <div class="line-light">Aroma kit</div>
                                    <div class="line-bold">Coffee aroma<br>molecules</div>
                                    <a class="read-article" href="#">Read the article</a>
                                </div>
                            </div>
                        </div>
                        <div class="roast-nav">
                            <span class="dots"><i class="is-on"></i><i></i><i></i></span>
                            <span class="arrows"><button type="button" aria-label="Previous">←</button><button type="button" aria-label="Next">→</button></span>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        <section id="new">
            <h2><a class="section-link" href="/Products">New</a></h2>
            <div class="card-grid">
                @foreach (var product in fresh)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </section>

        <section id="popular">
            <h2><a class="section-link" href="/Products">Popular</a></h2>
            <div class="card-grid">
                @foreach (var product in popular)
                {
                    <partial name="_ProductCard" model="product" />
                }
                <aside>
                    <div class="guarantee-card">
                        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.35-5.65M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                        <h3>We'll refund the money or replace it</h3>
                        <p>If you don't like the coffee, we'll replace it for free or refund your payment.</p>
                        <p>Just write to us, and we'll resolve the issue in your favor.</p>
                    </div>
                </aside>
            </div>
        </section>

        <section id="sets">
            <h2><a class="section-link" href="/Products/Sets">Sets</a></h2>
            <div class="card-grid">
                @foreach (var product in Model.Sets)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </section>

        <section id="reviews">
            <h2><a class="section-link" href="/Reviews">Reviews</a></h2>
            <div class="review-stats">
                <div class="stat">
                    <div class="stat-value">44,828</div>
                    <div class="stat-label">reviews</div>
                </div>
                <div class="stat">
                    <div class="stat-value">4.9</div>
                    <div class="stat-star">★</div>
                    <div class="stat-label">Average<br>shop rating</div>
                </div>
                <div class="stat">
                    <div class="stat-value">4.7</div>
                    <div class="stat-star">★</div>
                    <div class="stat-label">Average<br>delivery rating</div>
                </div>
            </div>
            <div class="review-grid">
                <article>
                    <div class="review">
                        <div class="review-head">
                            <div class="reviewer">
                                <div class="avatar">B</div>
                                <div>
                                    <div class="reviewer-name">Bagdagul</div>
                                    <div class="reviewer-level">Newcomer</div>
                                </div>
                            </div>
                            <div class="review-date">14.08.2026</div>
                        </div>
                        <div class="review-label">Shop <span class="stars">★★★★★</span></div>
                        <p>I'm happy with it</p>
                        <div class="review-label">Delivery <span class="stars">★★★★★</span></div>
                        <p>Fast</p>
                        <div class="review-label">Comment</div>
                        <p>Everything is as good as always, especially the coffee</p>
                    </div>
                </article>
                <article>
                    <div class="review">
                        <div class="review-head">
                            <div class="reviewer">
                                <div class="avatar">C</div>
                                <div>
                                    <div class="reviewer-name">Cavanshir</div>
                                    <div class="reviewer-level">Newcomer</div>
                                </div>
                            </div>
                            <div class="review-date">13.07.2026</div>
                        </div>
                        <div class="review-label">Shop <span class="stars">★★★★★</span></div>
                        <p>This was my first time at Janz. I liked everything. The welcome discount is nice too.</p>
                        <div class="review-label">Delivery <span class="stars">★★★★★</span></div>
                        <p>Delivery was fast. I'm happy.</p>
                        <div class="review-label">Comment</div>
                        <p>I liked the coffee. So far I'm happy with everything.</p>
                    </div>
                </article>
            </div>
        </section>
    </main>
