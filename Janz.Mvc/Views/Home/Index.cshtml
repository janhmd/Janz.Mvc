@model HomeIndexViewModel
@{
    ViewData["Title"] = "Home";
}

<section id="hero">
    <h1>Every day we roast coffee and<br>deliver for free all over Azerbaijan</h1>
    <div class="hero-row">
        <a class="shot" href="#">
            <video muted loop playsinline preload="metadata" src="@Url.Content("~/videos/espresso.mp4")"></video>
            <span>Coffee for espresso</span>
            <small>45</small>
        </a>
        <a class="shot" href="#">
            <video muted loop playsinline preload="metadata" src="@Url.Content("~/videos/filter.mp4")"></video>
            <span>Coffee for filter</span>
            <small>45</small>
        </a>
        <a class="shot" href="#">
            <video muted loop playsinline preload="metadata" src="@Url.Content("~/videos/merch.mp4")"></video>
            <span>Accessories and merch</span>
            <small>77</small>
        </a>
        <aside>
            <div class="account-card">
                <div class="account-title">Sign in, and it gets cheaper</div>
                <div class="account-note">More discounts in your account</div>
                <a class="account-signin" href="#">Sign in</a>
                <a class="account-register" href="#">Register</a>
            </div>
        </aside>
    </div>
</section>

<section id="week">
    <h2>Coffees of the week <span>on sale</span></h2>
    <div class="week-row">
        <article>
            <div class="product">
            <div class="product-top">
                <p>For espresso</p>
                <div class="product-meta">
                    <div class="rating">
                        <span class="rating-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>4.6</span>
                        <span class="rating-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z" /></svg>687</span>
                    </div>
                    <div class="badges">
                        <span>Coffee of the week</span>
                    </div>
                    <div class="tag-note">Popular</div>
                </div>
            </div>
            <h3><a class="product-link" asp-action="Product" asp-route-id="floral">Floral</a></h3>
            <div class="kind">Blend</div>
            <img class="product-photo" src="@Url.Content("~/images/floral.png")" alt="Floral espresso coffee" />
            <div class="taste">A light coffee with notes of <span class="note note-flowers">flowers</span>, <span class="note note-berries">dark berries</span> and <span class="note note-citrus">citrus</span></div>
            <div class="meters">
                <div>
                    <span>Density</span>
                    <i><b style="width:38%"></b></i>
                </div>
                <div>
                    <span>Acidity</span>
                    <i><b style="width:72%"></b></i>
                </div>
            </div>
            <div class="buy-row">
                <button type="button" class="weight is-on">250 g <small>-15%</small></button>
                <button type="button" class="weight">1000 g</button>
                <details class="grind click-menu">
                    <summary><span>Whole beans</span></summary>
                    <div class="grind-list">
                        <p>Grind</p>
                        <button type="button" class="is-on">Whole beans</button>
                        <button type="button">For French press (coarse)</button>
                        <button type="button">For drip coffee maker (coarse)</button>
                        <button type="button">For Chemex (coarse)</button>
                        <button type="button">For pour-over (medium)</button>
                        <button type="button">For AeroPress (medium)</button>
                        <button type="button">For moka pot (medium)</button>
                        <button type="button">For espresso, coarse (medium)</button>
                        <button type="button">For espresso, fine (fine)</button>
                        <button type="button">For Turkish coffee (fine)</button>
                        <button type="button">For a cup (medium)</button>
                    </div>
                </details>
            </div>
            <div class="price-row">
                <button type="button" class="price">
                    <small>-8%</small>
                    <s>₼32.50</s>
                    <strong>₼29.90</strong>
                </button>
                <span class="product-actions">
                    <button type="button" aria-label="Add to wishlist"><svg viewBox="0 0 24 24"><path d="M12 19s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
                    <button type="button" aria-label="Compare"><svg viewBox="0 0 24 24"><path d="M12 3v15M8 20h8M4.5 7h15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0zM19.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></button>
                    <button type="button" aria-label="Product details"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4M9.5 12h5M9.5 15.5h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
                </span>
            </div>

            </div>
        </article>

        <article>
            <div class="product">
            <div class="product-top">
                <p>For filter</p>
                <div class="product-meta">
                    <div class="rating">
                        <span class="rating-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>4.6</span>
                        <span class="rating-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z" /></svg>1041</span>
                    </div>
                    <div class="badges">
                        <span>Coffee of the week</span>
                    </div>
                </div>
            </div>
            <h3><a class="product-link" href="#">Guatemala Santiago</a></h3>
            <div class="kind">Washed</div>
            <img class="product-photo" src="@Url.Content("~/images/guatemala.png")" alt="Guatemala Santiago filter coffee" />
            <div class="taste">A sweet coffee with notes of <span class="note note-orange">orange</span>, <span class="note note-fruit">dried fruit</span> and <span class="note note-chocolate">milk chocolate</span></div>
            <div class="meters">
                <div>
                    <span>Density</span>
                    <i><b style="width:64%"></b></i>
                </div>
                <div>
                    <span>Acidity</span>
                    <i><b style="width:48%"></b></i>
                </div>
            </div>
            <div class="buy-row">
                <button type="button" class="weight is-on">250 g <small>-15%</small></button>
                <button type="button" class="weight">1000 g</button>
                <details class="grind click-menu">
                    <summary><span>Whole beans</span></summary>
                    <div class="grind-list">
                        <p>Grind</p>
                        <button type="button" class="is-on">Whole beans</button>
                        <button type="button">For French press (coarse)</button>
                        <button type="button">For drip coffee maker (coarse)</button>
                        <button type="button">For Chemex (coarse)</button>
                        <button type="button">For pour-over (medium)</button>
                        <button type="button">For AeroPress (medium)</button>
                        <button type="button">For moka pot (medium)</button>
                        <button type="button">For espresso, coarse (medium)</button>
                        <button type="button">For espresso, fine (fine)</button>
                        <button type="button">For Turkish coffee (fine)</button>
                        <button type="button">For a cup (medium)</button>
                    </div>
                </details>
            </div>
            <div class="price-row">
                <button type="button" class="price">
                    <small>-8%</small>
                    <s>₼29.90</s>
                    <strong>₼27.50</strong>
                </button>
                <span class="product-actions">
                    <button type="button" aria-label="Add to wishlist"><svg viewBox="0 0 24 24"><path d="M12 19s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
                    <button type="button" aria-label="Compare"><svg viewBox="0 0 24 24"><path d="M12 3v15M8 20h8M4.5 7h15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0zM19.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></button>
                    <button type="button" aria-label="Product details"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4M9.5 12h5M9.5 15.5h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
                </span>
            </div>

            </div>
        </article>

        <aside>
            <div class="roast-card">
            <div class="roast-track">
            <div class="roast-slide">
                <img src="@Url.Content("~/images/roast.png")" alt="Coffee beans in the roaster" />
                <div class="roast-copy">
                    <div class="line-light">Until the next roast</div>
                    <div class="line-bold">1 day 15 hours</div>
                    <div class="line-bold">We deliver</div>
                    <div class="line-light">for free</div>
                    <div class="line-bold">We'll refund the money,</div>
                    <div class="line-light">if you don't like the coffee</div>
                </div>
            </div>
            <div class="roast-slide">
                <img src="@Url.Content("~/images/journal.png")" alt="Barista pouring coffee" />
                <div class="roast-copy">
                    <div class="line-light">Coffee journal</div>
                    <div class="line-bold">What's in plant milk: what can be a red flag for a barista and guests</div>
                    <a class="read-article" href="#">Read the article</a>
                </div>
            </div>
            <div class="roast-slide">
                <img src="@Url.Content("~/images/aroma-kit.png")" alt="Coffee aroma kit" />
                <div class="roast-copy">
                    <div class="line-light">Aroma kit</div>
                    <div class="line-bold">Coffee aroma<br>molecules</div>
                    <a class="read-article" href="#">Read the article</a>
                </div>
            </div>
            </div>
            <div class="roast-nav">
                <span class="dots"><i class="is-on"></i><i></i><i></i></span>
                <span class="arrows"><button type="button" aria-label="Previous">←</button><button type="button" aria-label="Next">→</button></span>
            </div>
            </div>
        </aside>
    </div>
</section>

<section id="new">
    <h2><a class="section-link" href="#">New</a></h2>
    <svg class="svg-defs" aria-hidden="true"><defs><path id="sticker-ring" d="M50 50m-37 0a37 37 0 1 1 74 0a37 37 0 1 1-74 0" /></defs></svg>
    <div class="card-grid">
        @foreach (var coffee in Model.NewCoffees)
        {
            <partial name="_CoffeeCard" model="coffee" />
        }
    </div>
</section>

<section id="popular">
    <h2><a class="section-link" href="#">Popular</a></h2>
    <div class="card-grid">
        @foreach (var coffee in Model.PopularCoffees)
        {
            <partial name="_CoffeeCard" model="coffee" />
        }
        <aside>
            <div class="guarantee-card">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 12a8 8 0 1 1-2.35-5.65M20 4v5h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <h3>We'll refund the money or replace it</h3>
                <p>If you don't like the coffee, we'll replace it for free or refund your payment.</p>
                <p>Just write to us, and we'll resolve the issue in your favor.</p>
            </div>
        </aside>
    </div>
</section>

<section id="sets">
    <h2><a class="section-link" href="#">Sets</a></h2>
    <div class="card-grid">
        @foreach (var set in Model.Sets)
        {
            <partial name="_SetCard" model="set" />
        }
    </div>
</section>

<section id="reviews">
    <h2><a class="section-link" href="#">Reviews</a></h2>
    <div class="review-stats">
        <div class="stat">
            <div class="stat-value">@Model.ReviewCount</div>
            <div class="stat-label">reviews</div>
        </div>
        <div class="stat">
            <div class="stat-value">@Model.ShopRating</div>
            <div class="stat-star">★</div>
            <div class="stat-label">Average<br>shop rating</div>
        </div>
        <div class="stat">
            <div class="stat-value">@Model.DeliveryRating</div>
            <div class="stat-star">★</div>
            <div class="stat-label">Average<br>delivery rating</div>
        </div>
    </div>
    <div class="review-grid">
        @foreach (var review in Model.Reviews)
        {
            <partial name="_ReviewCard" model="review" />
        }
    </div>
</section>

@section Scripts {
    <script>
        document.querySelectorAll(".shot").forEach(function (card) {
            var video = card.querySelector("video");
            card.addEventListener("mouseenter", function () {
                video.play();
            });
            card.addEventListener("mouseleave", function () {
                video.pause();
                video.currentTime = 0;
            });
        });

        document.querySelectorAll(".grind").forEach(function (menu) {
            var label = menu.querySelector("summary span");
            menu.querySelectorAll(".grind-list button").forEach(function (option) {
                option.addEventListener("click", function () {
                    menu.querySelectorAll(".grind-list button").forEach(function (item) {
                        item.classList.toggle("is-on", item === option);
                    });
                    label.textContent = option.textContent;
                    menu.removeAttribute("open");
                });
            });
        });

        document.querySelectorAll(".buy-row").forEach(function (row) {
            var weights = row.querySelectorAll(".weight");
            weights.forEach(function (weight) {
                weight.addEventListener("click", function () {
                    weights.forEach(function (item) {
                        item.classList.toggle("is-on", item === weight);
                    });
                });
            });
        });

        var promo = document.querySelector(".roast-card");
        var track = promo.querySelector(".roast-track");
        var slides = promo.querySelectorAll(".roast-slide");
        var dots = promo.querySelectorAll(".dots i");
        var slideIndex = 0;
        function showSlide(next) {
            slideIndex = (next + slides.length) % slides.length;
            track.style.transform = "translateX(" + (-slideIndex * promo.clientWidth) + "px)";
            dots.forEach(function (dot, index) {
                dot.classList.toggle("is-on", index === slideIndex);
            });
        }
        promo.querySelector("[aria-label='Previous']").addEventListener("click", function () {
            showSlide(slideIndex - 1);
        });
        promo.querySelector("[aria-label='Next']").addEventListener("click", function () {
            showSlide(slideIndex + 1);
        });

        var dragX = 0;
        var dragging = false;
        promo.addEventListener("dragstart", function (event) {
            event.preventDefault();
        });
        promo.addEventListener("pointerdown", function (event) {
            if (event.target.closest("button, a")) return;
            event.preventDefault();
            dragging = true;
            dragX = event.clientX;
            promo.setPointerCapture(event.pointerId);
        });
        function endDrag(event) {
            if (!dragging) return;
            dragging = false;
            var moved = event.clientX - dragX;
            if (moved <= -30) showSlide(slideIndex + 1);
            else if (moved >= 30) showSlide(slideIndex - 1);
        }
        promo.addEventListener("pointerup", endDrag);
        promo.addEventListener("pointercancel", function () {
            dragging = false;
        });
    </script>
}
