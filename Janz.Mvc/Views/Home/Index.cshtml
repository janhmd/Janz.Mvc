<section class="hero">
    <h1>Every day we roast coffee and<br>deliver for free all over Azerbaijan</h1>
    <div class="hero-row">
        <a class="shot" href="#">
            <video muted loop playsinline preload="metadata" src="@Url.Content("~/videos/espresso.mp4")"></video>
            <span>Coffee for espresso</span>
            <small>45</small>
        </a>
        <a class="shot" href="#">
            <video muted loop playsinline preload="metadata" src="@Url.Content("~/videos/filter.mp4")"></video>
            <span>Coffee for filter</span>
            <small>45</small>
        </a>
        <a class="shot" href="#">
            <video muted loop playsinline preload="metadata" src="@Url.Content("~/videos/merch.mp4")"></video>
