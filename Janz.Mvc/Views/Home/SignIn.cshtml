@{
    ViewData["Title"] = "Sign in";
}

<main>        <section id="signin">
            <div class="entry-card">
                <h1>Sign in</h1>
                <form action="/Home/SignIn" method="post">
                    <label class="entry-field">
                        <input type="email" name="email" placeholder="Email" autocomplete="email" required />
                    </label>
                    <label class="entry-field">
                        <input type="password" name="password" placeholder="Password" autocomplete="current-password" required />
                        <button type="button" class="entry-eye" aria-label="Show password">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 12s3.6-6.5 9-6.5S21 12 21 12s-3.6 6.5-9 6.5S3 12 3 12z" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="12" r="2.4" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
                        </button>
                    </label>
                    <button type="submit" class="account-signin">Sign in</button>
                    <a class="entry-forgot" href="#">Forgot password?</a>
                    <label class="entry-remember">
                        <input type="checkbox" name="remember" />
                        Remember password
                    </label>
                </form>
            </div>
        </section>    </main>
