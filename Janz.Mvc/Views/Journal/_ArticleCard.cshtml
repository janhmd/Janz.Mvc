@model Janz.Mvc.ViewModels.Journal.ArticleCardUIVM
@{
    var href = $"/Journal/Article/{Model.Slug}";
    var date = Model.PublishedAt.ToLocalTime().ToString("d MMMM yyyy");
}
<div class="article-card" data-id="@Model.Id" data-title="@Model.Title" data-topic="@Model.Topic" data-tags="@string.Join(",", Model.Tags)" data-date="@date" data-sort="@Model.PublishedAt.ToString("s")" data-lead="@Model.Lead" data-image="@Model.CoverPath" data-href="@href" data-likes="@Model.Likes" data-comments="@Model.Comments" data-views="@Model.Views" data-mins="@(Model.Minutes)'">
    <a class="article-card-photo" href="@href">
        <img src="@Model.CoverPath" alt="" />
        <span class="article-progress"><i></i></span>
    </a>
    <div class="article-meta">@Model.Topic<br />@date</div>
    <h3><a href="@href">@Model.Title</a></h3>
    <p>@Model.Lead</p>
    <partial name="~/Views/Journal/_ArticleStats.cshtml" model="Model" />
</div>
