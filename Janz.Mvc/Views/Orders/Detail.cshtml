@model Janz.Mvc.ViewModels.Orders.OrderUIVM
@using Janz.Mvc.Helpers
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Order";
}

<main>
        <section id="cart">
            <h1 class="cart-title">Order #@Model.Id <span>@Model.Status</span></h1>
            @await Component.InvokeAsync("OrderDetailSummary", Model)
            <p class="order-help">Something wrong with this order? <a href="/Contact?order=@Model.Id#contact-form">Write to support</a></p>
            <p class="cart-empty"><a href="/Products">To catalog</a></p>
        </section>
    </main>
