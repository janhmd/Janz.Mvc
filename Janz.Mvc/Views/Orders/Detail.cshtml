@model Janz.Mvc.ViewModels.Orders.OrderUIVM
@using Janz.Mvc.Helpers
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Order";
}

<main>
        <section id="cart">
            <h1 class="cart-title">Order #@Model.Id <span>@Model.Status</span></h1>
            @if (!string.IsNullOrEmpty(Model.DeliveryLine))
            {
                <div class="order-delivery">
                    <span>Delivery</span>
                    <strong>@Model.DeliveryFullName · @Model.DeliveryPhone</strong>
                    <p>@Model.DeliveryLine, @Model.DeliveryCity, @Model.DeliveryPostalCode</p>
                </div>
            }
            <div class="cart-lines">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-line">
                        <a class="cart-line-photo" href="/Products/Detail/@item.ProductId"><img src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], item.ImagePath)" alt="@item.ProductName" /></a>
                        <div class="cart-line-info">
                            <a href="/Products/Detail/@item.ProductId">@item.ProductName</a>
                            @if (!string.IsNullOrEmpty(item.VariantLabel) || !string.IsNullOrEmpty(item.Grind)){<span class="cart-line-variant">@string.Join(" · ", new[] { item.VariantLabel, item.Grind }.Where(m => !string.IsNullOrEmpty(m)))</span>}
                            <div class="kind">₼@item.Price.ToString("0.00")</div>
                        </div>
                        <div class="cart-qty"><span>@item.Quantity</span></div>
                        <strong class="cart-line-total">₼@item.Total.ToString("0.00")</strong>
                    </div>
                }
            </div>
            @if (Model.CouponCode is not null)
            {
                <div class="cart-sum">
                    <span>Promo code @Model.CouponCode</span>
                    <strong>−₼@Model.Discount.ToString("0.00")</strong>
                </div>
            }
            <div class="cart-sum">
                <span>Total</span>
                <strong>₼@Model.Total.ToString("0.00")</strong>
            </div>
            @if (TempData["PayError"] is string payError)
            {
                <p class="entry-error">@payError</p>
            }
            @if (Model.IsPaid)
            {
                <div class="cart-sum">
                    <span>Paid by card @Model.PaidAt?.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                </div>
            }
            else if (Model.Status == "Pending" || Model.Status == "Processing")
            {
                @* Kartla ödəniş Stripe-ın səhifəsində olur; ödəmək istəməyən çatdırılanda ödəyir *@
                <div class="cart-sum">
                    <span>Pay now by card or on delivery</span>
                    <form method="post" asp-controller="Orders" asp-action="Pay" asp-route-id="@Model.Id">
                        <button type="submit" class="cart-place">Pay by card</button>
                    </form>
                </div>
            }
            @if (ViewBag.Review is Janz.Mvc.ViewModels.Reviews.OrderReviewUIVM orderReview && orderReview.CanReview)
            {
                var mine = orderReview.Review;
                <form class="review-form order-review" method="post" asp-controller="Orders" asp-action="Review" asp-route-id="@Model.Id">
                    <h2>@(mine is null ? "Rate this order" : "Your review")</h2>
                    @if (TempData["ReviewError"] is string reviewError)
                    {
                        <p class="entry-error">@reviewError</p>
                    }
                    <span class="entry-caption">Shop</span>
                    <div class="star-input" role="radiogroup" aria-label="Shop rating">
                        @for (var i = 5; i >= 1; i--)
                        {
                            <input type="radio" name="shopRating" value="@i" id="shop-@i" checked="@((mine?.ShopRating ?? 5) == i)" />
                            <label for="shop-@i" aria-label="@i stars">★</label>
                        }
                    </div>
                    <textarea name="shopText" rows="2" maxlength="500" placeholder="How was the shop?">@mine?.ShopText</textarea>
                    <span class="entry-caption">Delivery</span>
                    <div class="star-input" role="radiogroup" aria-label="Delivery rating">
                        @for (var i = 5; i >= 1; i--)
                        {
                            <input type="radio" name="deliveryRating" value="@i" id="delivery-@i" checked="@((mine?.DeliveryRating ?? 5) == i)" />
                            <label for="delivery-@i" aria-label="@i stars">★</label>
                        }
                    </div>
                    <textarea name="deliveryText" rows="2" maxlength="500" placeholder="How was the delivery?">@mine?.DeliveryText</textarea>
                    <span class="entry-caption">Comment</span>
                    <textarea name="comment" rows="3" maxlength="1000" placeholder="Anything else you want to tell us">@mine?.Comment</textarea>
                    <div class="review-form-actions">
                        <button type="submit" class="account-signin">@(mine is null ? "Send the review" : "Save")</button>
                    </div>
                    <p class="comments-note">To rate a coffee itself, open it and use the Comments tab.</p>
                </form>
            }
            <p class="cart-empty"><a href="/Products">To catalog</a></p>
        </section>
    </main>
