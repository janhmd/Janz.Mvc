@model Janz.Mvc.ViewModels.Orders.OrderUIVM
@using Janz.Mvc.Helpers
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Order";
}

<main>
        <section id="cart">
            <h1 class="cart-title">Order #@Model.Id <span>@Model.Status</span></h1>
            @if (!string.IsNullOrEmpty(Model.DeliveryLine))
            {
                <div class="order-delivery">
                    <span>Delivery</span>
                    <strong>@Model.DeliveryFullName · @Model.DeliveryPhone</strong>
                    <p>@Model.DeliveryLine, @Model.DeliveryCity, @Model.DeliveryPostalCode</p>
                </div>
            }
            <div class="cart-lines">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-line">
                        <a class="cart-line-photo" href="/Products/Detail/@item.ProductId"><img src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], item.ImagePath)" alt="@item.ProductName" /></a>
                        <div class="cart-line-info">
                            <a href="/Products/Detail/@item.ProductId">@item.ProductName</a>
                            @if (!string.IsNullOrEmpty(item.VariantLabel) || !string.IsNullOrEmpty(item.Grind)){<span class="cart-line-variant">@string.Join(" · ", new[] { item.VariantLabel, item.Grind }.Where(m => !string.IsNullOrEmpty(m)))</span>}
                            <div class="kind">₼@item.Price.ToString("0.00")</div>
                        </div>
                        <div class="cart-qty"><span>@item.Quantity</span></div>
                        <strong class="cart-line-total">₼@item.Total.ToString("0.00")</strong>
                    </div>
                }
            </div>
            <div class="cart-sum">
                <span>Total</span>
                <strong>₼@Model.Total.ToString("0.00")</strong>
            </div>
            <p class="cart-empty"><a href="/Products">To catalog</a></p>
        </section>
    </main>
