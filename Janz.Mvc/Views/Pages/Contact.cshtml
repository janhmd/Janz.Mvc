@model Janz.Mvc.ViewModels.Settings.SiteSettingUIVM
@{
    ViewData["Title"] = "Contact";
    var tel = Model.Phone.Replace(" ", string.Empty);
    // Ünvanda şəhər yazılmayıbsa Google yalnız ümumi Bakı xəritəsini göstərir, ona görə şəhər və ölkə əlavə olunur
    var fullAddress = Model.Address;
    if (!fullAddress.Contains("Baku", StringComparison.OrdinalIgnoreCase) && !fullAddress.Contains("Bakı", StringComparison.OrdinalIgnoreCase))
    {
        fullAddress += ", Baku, Azerbaijan";
    }
    var pinned = (string?)ViewBag.MapQuery;
    var mapQuery = Uri.EscapeDataString(string.IsNullOrWhiteSpace(pinned) ? fullAddress : pinned.Trim());
}

<main>
    <section id="contact-page">
        <div class="contact-wrap">
            <div class="contact-info">
                <h1>Contact</h1>
                <a class="contact-phone" href="tel:@tel">@Model.Phone</a>
                <a class="contact-mail" href="mailto:@Model.Email">@Model.Email</a>
                <p class="contact-address">@Model.Address</p>
                <p class="contact-social-title">You can also reach us through messengers:</p>
                <div class="contact-social">
                    <a href="@Model.WhatsApp" target="_blank" rel="noopener" aria-label="WhatsApp">
                        <svg viewBox="0 0 24 24"><path d="M12 4.2a7.6 7.6 0 0 0-6.6 11.3L4.4 19.6l4.2-1.1A7.6 7.6 0 1 0 12 4.2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9.2 9.4c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.4.2.5.6 1.5.6 1.6s0 .3-.2.5l-.3.4c-.1.1-.2.3 0 .5.2.3.7 1.1 1.5 1.5.6.3 1 .4 1.2.2l.5-.6c.1-.2.3-.1.5-.1.6.2 1.3.6 1.4.8.1.2.1.7-.2 1.1-.2.4-1.2.8-1.7.7-.5 0-1.1-.1-2.4-.9-1.5-.9-2.5-2.3-2.6-2.5-.2-.3-.8-1.1-.8-2.1s.6-1.5.8-1.7z" fill="currentColor"/></svg>
                    </a>
                    <a href="@Model.Instagram" target="_blank" rel="noopener" aria-label="Instagram">
                        <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="17.1" cy="6.9" r=".9" fill="currentColor"/></svg>
                    </a>
                    <a href="mailto:@Model.Email" aria-label="Email">
                        <svg viewBox="0 0 24 24"><path d="M3.5 6.5h17v11h-17z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3.5 7l8.5 6.5L20.5 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                    </a>
                </div>
                <p class="contact-hours">@Model.Hours</p>
            </div>
            <div class="contact-map">
                <iframe title="Map" loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                        src="https://www.google.com/maps?q=@mapQuery&output=embed"></iframe>
                <a class="contact-map-open" href="https://www.google.com/maps/search/?api=1&query=@mapQuery" target="_blank" rel="noopener">Open in Google Maps</a>
            </div>
        </div>
    </section>
</main>
