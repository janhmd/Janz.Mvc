@model List<ProductUIVM>
@{
    ViewData["Title"] = "Chocolate and syrups";
}

<main>        <section id="chocolate">
            <h1>Chocolate and syrups</h1>
            <div class="gear-row">
                <a class="catalog-tile@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Chocolate bars")) ? " is-on" : null)" href="?tag=@CatalogQuery.Slug("Chocolate bars")"><video muted loop playsinline preload="metadata" src="/videos/choc-bars.mp4"></video><span>Chocolate bars</span></a>
                <a class="catalog-tile@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Chocolate shavings")) ? " is-on" : null)" href="?tag=@CatalogQuery.Slug("Chocolate shavings")"><video muted loop playsinline preload="metadata" src="/videos/choc-shavings.mp4"></video><span>Chocolate shavings</span></a>
                <a class="catalog-tile@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Syrups")) ? " is-on" : null)" href="?tag=@CatalogQuery.Slug("Syrups")"><video muted loop playsinline preload="metadata" src="/videos/choc-syrup.mp4"></video><span>Syrups</span></a>
                <a class="catalog-tile@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Dry syrups")) ? " is-on" : null)" href="?tag=@CatalogQuery.Slug("Dry syrups")"><video muted loop playsinline preload="metadata" src="/videos/choc-dry-syrup.mp4"></video><span>Dry syrups</span></a>
                <a class="catalog-tile@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Dry bases")) ? " is-on" : null)" href="?tag=@CatalogQuery.Slug("Dry bases")"><video muted loop playsinline preload="metadata" src="/videos/choc-dry-base.mp4"></video><span>Dry bases</span></a>
            </div>
            <form class="listing-form" method="get" data-auto-submit>
            @if (Context.Request.Query["tag"].FirstOrDefault() is string tag && tag != "")
            {
                <input type="hidden" name="tag" value="@tag" />
            }
            <label class="listing-sort">
                <select name="sort" aria-label="Sort">
                    <option value="" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "" || string.IsNullOrEmpty(Context.Request.Query["sort"].FirstOrDefault()))">Sort</option>
                    <option value="popular" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "popular")">Popular</option>
                    <option value="new" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "new")">New</option>
                    <option value="price-asc" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "price-asc")">Price, low to high</option>
                    <option value="price-desc" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "price-desc")">Price, high to low</option>
                    <option value="rating" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "rating")">Rating</option>
                </select>
            </label>
            </form>
            <div class="card-grid">
                @foreach (var product in Model)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </section>    </main>
