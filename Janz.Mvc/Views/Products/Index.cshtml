@model List<ProductUIVM>
@{
    ViewData["Title"] = ViewBag.Query is string title ? $"Search: {title}" : "Coffee catalog";
}

<main>
        <section id="catalog">
            <h1>@(ViewBag.Query is string heading ? $"Search: {heading}" : "Coffee catalog")</h1>
            @await Component.InvokeAsync("CatalogTiles", Model)
            @await Component.InvokeAsync("CatalogTags", Model)
            <form class="catalog-board" method="get" data-auto-submit>
                @if (ViewBag.Query is string searchQuery)
                {
                    <input type="hidden" name="q" value="@searchQuery" />
                }
                @await Component.InvokeAsync("CatalogFilters", Model)
                @await Component.InvokeAsync("CatalogListing", Model)
            </form>
        </section>
    </main>
