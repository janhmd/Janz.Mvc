@model List<ProductUIVM>
@{
    ViewData["Title"] = ViewBag.Query is string title ? $"Search: {title}" : "Coffee catalog";
}

<main>
        <section id="catalog">
            <h1>@(ViewBag.Query is string heading ? $"Search: {heading}" : "Coffee catalog")</h1>
            <div class="catalog-row">
                <a class="catalog-tile" href="?use=espresso">
                    <img src="/images/tiles/espresso.jpg" alt="" /><video muted loop playsinline preload="metadata" src="/videos/espresso.mp4"></video>
                    <span>Coffee for espresso</span>
                </a>
                <a class="catalog-tile" href="?use=filter">
                    <img src="/images/tiles/filter.jpg" alt="" /><video muted loop playsinline preload="metadata" src="/videos/filter.mp4"></video>
                    <span>Coffee for filter</span>
                </a>
                <a class="catalog-tile" href="?format=capsules">
                    <img src="/images/tiles/capsules.jpg" alt="" /><video muted loop playsinline preload="metadata" src="/videos/capsules.mp4"></video>
                    <span>Capsules</span>
                </a>
                <a class="catalog-tile" href="?format=drip">
                    <img src="/images/tiles/drip.jpg" alt="" /><video muted loop playsinline preload="metadata" src="/videos/drip.mp4"></video>
                    <span>Drip bags</span>
                </a>
                <a class="catalog-tile" href="?format=cans">
                    <img src="/images/tiles/cans.jpg" alt="" /><video muted loop playsinline preload="metadata" src="/videos/cans.mp4"></video>
                    <span>Drinks in cans</span>
                </a>
                <a class="catalog-tile" href="?format=concentrate">
                    <img src="/images/tiles/concentrate.jpg" alt="" /><video muted loop playsinline preload="metadata" src="/videos/concentrate.mp4"></video>
                    <span>Coffee concentrate</span>
                </a>
                <a class="catalog-tile" href="?format=instant">
                    <img src="/images/tiles/instant.jpg" alt="" /><video muted loop playsinline preload="metadata" src="/videos/instant.mp4"></video>
                    <span>Instant specialty</span>
                </a>
            </div>
            <div class="catalog-tags">
                <a class="tag-minute" href="#">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.2 4.2L17.5 8.5 13.2 9.8 12 14l-1.2-4.2L6.5 8.5l4.3-1.3zM18 13l.6 2 2 .6-2 .6-.6 2-.6-2-2-.6 2-.6z" /></svg>
                    Choose coffee in a minute
                </a>
                <a href="?tag=@CatalogQuery.Slug("For an espresso machine")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("For an espresso machine")) ? "is-on" : null)">For an espresso machine</a>
                <a href="?tag=@CatalogQuery.Slug("For Turkish coffee")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("For Turkish coffee")) ? "is-on" : null)">For Turkish coffee</a>
                <a href="?tag=@CatalogQuery.Slug("For milk drinks")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("For milk drinks")) ? "is-on" : null)">For milk drinks</a>
                <a href="?tag=@CatalogQuery.Slug("For a portafilter")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("For a portafilter")) ? "is-on" : null)">For a portafilter</a>
                <a href="?tag=@CatalogQuery.Slug("Ground coffee")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Ground coffee")) ? "is-on" : null)">Ground coffee</a>
                <a href="?tag=@CatalogQuery.Slug("Coffee with low acidity")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Coffee with low acidity")) ? "is-on" : null)">Coffee with low acidity</a>
                <a href="?tag=@CatalogQuery.Slug("For a cup")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("For a cup")) ? "is-on" : null)">For a cup</a>
                <a href="?tag=@CatalogQuery.Slug("Fermented coffee")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Fermented coffee")) ? "is-on" : null)">Fermented coffee</a>
                <a href="?tag=@CatalogQuery.Slug("Limited edition")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Limited edition")) ? "is-on" : null)">Limited edition</a>
                <a href="?tag=@CatalogQuery.Slug("Whole bean")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Whole bean")) ? "is-on" : null)">Whole bean</a>
                <a href="?tag=@CatalogQuery.Slug("Whole bean 1 kg")" class="@(CatalogQuery.Has(Context.Request, "tag", CatalogQuery.Slug("Whole bean 1 kg")) ? "is-on" : null)">Whole bean 1 kg</a>
                <button type="button" aria-expanded="false" aria-label="More filters">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
            </div>
            <form class="catalog-board" method="get" data-auto-submit>
                @if (ViewBag.Query is string searchQuery)
                {
                    <input type="hidden" name="q" value="@searchQuery" />
                }
                <div class="filter-col">
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Price, ₼ <svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner filter-price">
                            <input type="number" name="minPrice" min="0" step="1" placeholder="from" value="@Context.Request.Query["minPrice"]" aria-label="Price from" />
                            <input type="number" name="maxPrice" min="0" step="1" placeholder="to" value="@Context.Request.Query["maxPrice"]" aria-label="Price to" />
                        </div></div>
                    </div>
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Rating <svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner">
                            <label><input type="radio" name="minRating" value="" checked="@string.IsNullOrEmpty(Context.Request.Query["minRating"])"> Any</label>
                            <label><input type="radio" name="minRating" value="4" checked="@CatalogQuery.Has(Context.Request, "minRating", "4")"> 4 ★ and higher</label>
                            <label><input type="radio" name="minRating" value="4.5" checked="@CatalogQuery.Has(Context.Request, "minRating", "4.5")"> 4.5 ★ and higher</label>
                        </div></div>
                    </div>
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Acidity <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M8 7.2V11.2M8 4.8h.01" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner">
                            <label><input type="checkbox" name="acidity" value="low" checked="@CatalogQuery.Has(Context.Request, "acidity", "low")"> Low</label>
                            <label><input type="checkbox" name="acidity" value="medium" checked="@CatalogQuery.Has(Context.Request, "acidity", "medium")"> Medium</label>
                            <label><input type="checkbox" name="acidity" value="high" checked="@CatalogQuery.Has(Context.Request, "acidity", "high")"> High</label>
                        </div></div>
                    </div>
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Density <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M8 7.2V11.2M8 4.8h.01" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner">
                            <label><input type="checkbox" name="density" value="low" checked="@CatalogQuery.Has(Context.Request, "density", "low")"> Low</label>
                            <label><input type="checkbox" name="density" value="medium" checked="@CatalogQuery.Has(Context.Request, "density", "medium")"> Medium</label>
                            <label><input type="checkbox" name="density" value="high" checked="@CatalogQuery.Has(Context.Request, "density", "high")"> High</label>
                        </div></div>
                    </div>
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Roast <svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner">
                            <label><input type="checkbox" name="roast" value="light" checked="@CatalogQuery.Has(Context.Request, "roast", "light")"> Light (for filter)</label>
                            <label><input type="checkbox" name="roast" value="medium" checked="@CatalogQuery.Has(Context.Request, "roast", "medium")"> Medium (for espresso)</label>
                            <label><input type="checkbox" name="roast" value="dark" checked="@CatalogQuery.Has(Context.Request, "roast", "dark")"> Dark (for milk)</label>
                        </div></div>
                    </div>
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Taste <svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner">
                            <label><input type="checkbox" name="taste" value="chocolate" checked="@CatalogQuery.Has(Context.Request, "taste", "chocolate")"> Chocolate / Nuts</label>
                            <label><input type="checkbox" name="taste" value="flowers" checked="@CatalogQuery.Has(Context.Request, "taste", "flowers")"> Flowers / Citrus</label>
                            <label><input type="checkbox" name="taste" value="fruit" checked="@CatalogQuery.Has(Context.Request, "taste", "fruit")"> Fruits / Berries</label>
                            <label><input type="checkbox" name="taste" value="alcohol" checked="@CatalogQuery.Has(Context.Request, "taste", "alcohol")"> Alcohol / Funky</label>
                        </div></div>
                    </div>
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Process <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M8 7.2V11.2M8 4.8h.01" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner">
                            <label><input type="checkbox" name="process" value="washed" checked="@CatalogQuery.Has(Context.Request, "process", "washed")"> Washed</label>
                            <label><input type="checkbox" name="process" value="natural" checked="@CatalogQuery.Has(Context.Request, "process", "natural")"> Natural</label>
                            <label><input type="checkbox" name="process" value="honey" checked="@CatalogQuery.Has(Context.Request, "process", "honey")"> Honey</label>
                            <label><input type="checkbox" name="process" value="funky" checked="@CatalogQuery.Has(Context.Request, "process", "funky")"> Funky</label>
                            <label><input type="checkbox" name="process" value="blend" checked="@CatalogQuery.Has(Context.Request, "process", "blend")"> Blend</label>
                            <label><input type="checkbox" name="process" value="other" checked="@CatalogQuery.Has(Context.Request, "process", "other")"> Other</label>
                        </div></div>
                    </div>
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Country <svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.2" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M8 7.2V11.2M8 4.8h.01" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg><svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner">
                            <label><input type="checkbox" name="country" value="brazil" checked="@CatalogQuery.Has(Context.Request, "country", "brazil")"> Brazil</label>
                            <label><input type="checkbox" name="country" value="ethiopia" checked="@CatalogQuery.Has(Context.Request, "country", "ethiopia")"> Ethiopia</label>
                            <label><input type="checkbox" name="country" value="colombia" checked="@CatalogQuery.Has(Context.Request, "country", "colombia")"> Colombia</label>
                            <label><input type="checkbox" name="country" value="costa-rica" checked="@CatalogQuery.Has(Context.Request, "country", "costa-rica")"> Costa Rica</label>
                            <label><input type="checkbox" name="country" value="kenya" checked="@CatalogQuery.Has(Context.Request, "country", "kenya")"> Kenya</label>
                            <label><input type="checkbox" name="country" value="rwanda" checked="@CatalogQuery.Has(Context.Request, "country", "rwanda")"> Rwanda</label>
                            <label><input type="checkbox" name="country" value="uganda" checked="@CatalogQuery.Has(Context.Request, "country", "uganda")"> Uganda</label>
                            <label><input type="checkbox" name="country" value="peru" checked="@CatalogQuery.Has(Context.Request, "country", "peru")"> Peru</label>
                            <label><input type="checkbox" name="country" value="burundi" checked="@CatalogQuery.Has(Context.Request, "country", "burundi")"> Burundi</label>
                            <label><input type="checkbox" name="country" value="guatemala" checked="@CatalogQuery.Has(Context.Request, "country", "guatemala")"> Guatemala</label>
                            <label><input type="checkbox" name="country" value="indonesia" checked="@CatalogQuery.Has(Context.Request, "country", "indonesia")"> Indonesia</label>
                            <label><input type="checkbox" name="country" value="yemen" checked="@CatalogQuery.Has(Context.Request, "country", "yemen")"> Yemen</label>
                            <label><input type="checkbox" name="country" value="bolivia" checked="@CatalogQuery.Has(Context.Request, "country", "bolivia")"> Bolivia</label>
                            <label><input type="checkbox" name="country" value="malaysia" checked="@CatalogQuery.Has(Context.Request, "country", "malaysia")"> Malaysia</label>
                        </div></div>
                    </div>
                    <div class="filter-group">
                        <h2><button type="button" aria-expanded="true">Feature <svg class="filter-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></button></h2>
                        <div class="filter-options"><div class="filter-options-inner">
                            <label><input type="checkbox" name="feature" value="blend" checked="@CatalogQuery.Has(Context.Request, "feature", "blend")"> Blend</label>
                            <label><input type="checkbox" name="feature" value="decaf" checked="@CatalogQuery.Has(Context.Request, "feature", "decaf")"> Decaf / Low caffeine</label>
                            <label><input type="checkbox" name="feature" value="single" checked="@CatalogQuery.Has(Context.Request, "feature", "single")"> Single origin</label>
                            <label><input type="checkbox" name="feature" value="microlot" checked="@CatalogQuery.Has(Context.Request, "feature", "microlot")"> Microlot</label>
                            <label><input type="checkbox" name="feature" value="milk" checked="@CatalogQuery.Has(Context.Request, "feature", "milk")"> Ideal for milk drinks</label>
                            <label><input type="checkbox" name="feature" value="limited" checked="@CatalogQuery.Has(Context.Request, "feature", "limited")"> Limited edition</label>
                        </div></div>
                    </div>
                </div>
                <div class="listing-main">
                    <div class="listing-tabs">
                        <button type="submit" name="tab" value="@CatalogQuery.TabValue("All")" class="@(CatalogQuery.IsTab(Context.Request, "All") ? "is-on" : null)" aria-pressed="@(CatalogQuery.IsTab(Context.Request, "All") ? "true" : "false")">All</button>
                        <button type="submit" name="tab" value="@CatalogQuery.TabValue("Recommended")" class="@(CatalogQuery.IsTab(Context.Request, "Recommended") ? "is-on" : null)" aria-pressed="@(CatalogQuery.IsTab(Context.Request, "Recommended") ? "true" : "false")">Recommended</button>
                        <button type="submit" name="tab" value="@CatalogQuery.TabValue("Popular")" class="@(CatalogQuery.IsTab(Context.Request, "Popular") ? "is-on" : null)" aria-pressed="@(CatalogQuery.IsTab(Context.Request, "Popular") ? "true" : "false")">Popular</button>
                        <button type="submit" name="tab" value="@CatalogQuery.TabValue("New")" class="@(CatalogQuery.IsTab(Context.Request, "New") ? "is-on" : null)" aria-pressed="@(CatalogQuery.IsTab(Context.Request, "New") ? "true" : "false")">New</button>
                        <button type="submit" name="tab" value="@CatalogQuery.TabValue("Coffee of the week")" class="@(CatalogQuery.IsTab(Context.Request, "Coffee of the week") ? "is-on" : null)" aria-pressed="@(CatalogQuery.IsTab(Context.Request, "Coffee of the week") ? "true" : "false")">Coffee of the week</button>
                        <button type="submit" name="tab" value="@CatalogQuery.TabValue("Running out")" class="@(CatalogQuery.IsTab(Context.Request, "Running out") ? "is-on" : null)" aria-pressed="@(CatalogQuery.IsTab(Context.Request, "Running out") ? "true" : "false")">Running out</button>
                        <button type="submit" name="tab" value="@CatalogQuery.TabValue("Microlot")" class="@(CatalogQuery.IsTab(Context.Request, "Microlot") ? "is-on" : null)" aria-pressed="@(CatalogQuery.IsTab(Context.Request, "Microlot") ? "true" : "false")">Microlot</button>
                    </div>
                    <label class="listing-sort">
                        <select name="sort" aria-label="Sort">
                            <option value="" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "" || string.IsNullOrEmpty(Context.Request.Query["sort"].FirstOrDefault()))">Sort</option>
                            <option value="popular" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "popular")">Popular</option>
                            <option value="new" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "new")">New</option>
                            <option value="price-asc" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "price-asc")">Price, low to high</option>
                            <option value="price-desc" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "price-desc")">Price, high to low</option>
                            <option value="rating" selected="@(Context.Request.Query["sort"].FirstOrDefault() == "rating")">Rating</option>
                        </select>
                    </label>
                    @if (Model.Count == 0)
                    {
                        <p class="catalog-empty">Nothing matches these filters. <a href="@Context.Request.Path">Clear the filters</a></p>
                    }
                    <div class="card-grid">
                        @foreach (var product in Model)
                        {
                            <partial name="_ProductCard" model="product" />
                        }
                    </div>
                </div>
            </form>
        </section>
    </main>
