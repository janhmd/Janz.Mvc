@model List<ProductUIVM>
@{
    ViewData["Title"] = "Sets with coffee";
}

<main>        <section id="bundles">
            <h1>Sets with coffee</h1>
            <div class="gear-row">
                <a class="catalog-tile" href="#"><video muted loop playsinline preload="metadata" src="/videos/set-samples.mp4"></video><span>Sample boxes</span></a>
                <a class="catalog-tile" href="#"><video muted loop playsinline preload="metadata" src="/videos/set-gifts.mp4"></video><span>Gift sets</span></a>
            </div>
            <label class="listing-sort">
                <select aria-label="Sort">
                    <option value="" selected>Sort</option>
                    <option value="popular">Popular</option>
                    <option value="new">New</option>
                    <option value="price-asc">Price, low to high</option>
                    <option value="price-desc">Price, high to low</option>
                    <option value="rating">Rating</option>
                </select>
            </label>
            <div class="card-grid">
                @foreach (var product in Model)
                {
                    <partial name="_ProductCard" model="product" />
                }
            </div>
        </section>    </main>
