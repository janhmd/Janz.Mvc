@model List<Janz.Mvc.ViewModels.Products.ProductUIVM>

@if (Model.Count == 0)
{
    <p class="pick-note">There is no coffee in stock right now. Please check back soon.</p>
}
else
{
    <p class="pick-note">@(ViewBag.Exact == true ? "Your coffee, picked by your answers:" : "No exact match, so here are our best rated coffees:")</p>
    <div class="card-grid pick-cards">
        @foreach (var product in Model)
        {
            <partial name="_ProductCard" model="product" />
        }
    </div>
}
