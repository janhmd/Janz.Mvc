@model Janz.Mvc.ViewModels.Profile.ProfilePageVM
@{
    ViewData["Title"] = "Account";
    var error = TempData["AccountError"] as string ?? ViewBag.Error as string;
    var me = Model.Profile;
    var userName = string.IsNullOrWhiteSpace(me.FullName) ? User.Identity?.Name : me.FullName;
    if (string.IsNullOrWhiteSpace(userName))
    {
        userName = "Coffee lover";
    }
    var letter = userName.Trim().Substring(0, 1).ToUpperInvariant();
    var stats = Model.Statistics;
    var phoneCode = new[] { "+994", "+90", "+7" }.FirstOrDefault(code => me.Phone?.StartsWith(code) == true) ?? "+994";
    var phoneNumber = me.Phone is null ? string.Empty : me.Phone.Substring(me.Phone.StartsWith(phoneCode) ? phoneCode.Length : 0).Trim();
    var Initial = string.IsNullOrWhiteSpace(Model.Community.Author.Name) ? letter : Model.Community.Author.Name.Substring(0, 1).ToUpperInvariant();
    var memberDays = Model.Community.Stats.MemberSince == default ? 0 : (DateTime.UtcNow - Model.Community.Stats.MemberSince.ToUniversalTime()).TotalDays;
    var memberMonths = Math.Max(0, (int)(memberDays / 30.4));
    var OnSite = Model.Community.Stats.MemberSince == default ? "-" : memberMonths >= 12 ? $"{memberMonths / 12} {(memberMonths / 12 == 1 ? "year" : "years")} {memberMonths % 12} {(memberMonths % 12 == 1 ? "month" : "months")}" : $"{memberMonths} {(memberMonths == 1 ? "month" : "months")}";
}

<main>
        <section id="account">
            <div class="cabinet-top">
                <h1>Personal account</h1>
                <div class="cabinet-balance">
                    <a class="cabinet-replenish" href="#ledger">Replenish</a>
                    <a class="cabinet-balance-sum" href="#ledger"><strong>Balance @Model.Balance.Balance.ToString("0.##")₼</strong></a>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(error))
            {
                <span data-toast-error="@error" hidden></span>
            }
            <div class="cabinet-row">
                <nav aria-label="Account">
                    <div class="cabinet-nav">
                        <a href="#statistics" class="cabinet-tab" data-pane="statistics">Statistics</a>
                        <a href="#orders" class="cabinet-tab is-on" data-pane="orders">Orders</a>
                        <a href="#notifications" class="cabinet-tab" data-pane="notifications">Notifications</a>
                        <a href="#community" class="cabinet-tab" data-pane="community">Community profile</a>
                        <a href="#details" class="cabinet-tab" data-pane="details">My details</a>
                        <a href="#ledger" class="cabinet-tab" data-pane="ledger">Internal account</a>
                        <a href="#journal" class="cabinet-tab" data-pane="journal">Reading in the journal</a>
                        <a href="#blacklist" class="cabinet-tab" data-pane="blacklist">Blacklist</a>
                    </div>
                </nav>
                <div class="cabinet-main">
                    <!-- Orders from the API: newest first, each opens the order page -->
                    @await Component.InvokeAsync("ProfileOrders", Model)
                    @await Component.InvokeAsync("ProfileNotifications", Model)
                    @await Component.InvokeAsync("ProfileCommunity", Model)
                    @await Component.InvokeAsync("ProfileDetails", Model)
                    @await Component.InvokeAsync("ProfileLedger", Model)
                    @await Component.InvokeAsync("ProfileJournal", Model)
                    @await Component.InvokeAsync("ProfileBlacklist", Model)
                    @await Component.InvokeAsync("ProfileStatistics", Model)
                </div>
            </div>
        </section>
    </main>

    @await Component.InvokeAsync("ProfileDialogs", Model)
    
