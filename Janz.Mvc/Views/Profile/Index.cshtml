                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.4 6.2h11.2v3.2H6.4zM8.2 9.4h7.6v8.2H8.2z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M10 12.2h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
