@model Janz.Mvc.ViewModels.Reviews.ShopReviewsUIVM
@{
    ViewData["Title"] = "Reviews";
}

<main>        <section id="feedback">
            <h1>Reviews <span>@Model.Total.ToString("N0")</span></h1>
            <div class="feedback-board">
                <div class="score-groups">
                    @foreach (var group in new[] { ("With a shop rating", "shop", Model.ShopCounts, Model.ShopStars), ("With a delivery rating", "delivery", Model.DeliveryCounts, Model.DeliveryStars) })
                    {
                        <div class="score-block">
                            <p>@group.Item1</p>
                            <ul>
                                @for (var star = 5; star >= 1; star--)
                                {
                                    <li>
                                        <label class="score-filter">
                                            <input type="checkbox" form="review-filter" name="@group.Item2" value="@star" checked="@group.Item4.Contains(star)" data-auto-submit />
                                            <span class="score-box" aria-hidden="true"></span>
                                            <span class="score-stars" aria-label="@star stars">@for (var i = 1; i <= 5; i++){<span class="@(i <= star ? "is-on" : null)">★</span>}</span>
                                            <span class="score-count">@(group.Item3.ElementAtOrDefault(5 - star))</span>
                                        </label>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <div class="feedback-scores">
                    <div class="stat"><div class="stat-value">@(Model.ShopAverage?.ToString("0.0") ?? "—")</div><div class="stat-star">★</div><div class="stat-label">Average<br>shop rating</div></div>
                    <div class="stat"><div class="stat-value">@(Model.DeliveryAverage?.ToString("0.0") ?? "—")</div><div class="stat-star">★</div><div class="stat-label">Average<br>delivery rating</div></div>
                </div>
            </div>
            <form id="review-filter" class="review-search" method="get" action="/Reviews" role="search">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
                <input type="search" name="q" value="@Model.Search" placeholder="Search" maxlength="100" aria-label="Search the reviews" />
            </form>
            @{
                var signedIn = User.Identity?.IsAuthenticated == true;
                var writeName = signedIn ? User.Identity?.Name : null;
                var initial = string.IsNullOrWhiteSpace(writeName) ? "+" : writeName.Trim()[..1].ToUpperInvariant();
                var reviewOrderId = ViewBag.ReviewOrderId as int?;
                var orderReview = ViewBag.OrderReview as Janz.Mvc.ViewModels.Reviews.OrderReviewUIVM;
                var mine = orderReview?.Review;
                var reviewError = TempData["ReviewError"] as string;
            }
            @if (!signedIn)
            {
                <a class="write-review" href="/Account/Login?returnUrl=@Uri.EscapeDataString("/Reviews")">
                    <span class="avatar">@initial</span>
                    <span class="write-review-text">Write a review</span>
                </a>
            }
            else if (reviewOrderId is not null && orderReview?.CanReview == true)
            {
                <details class="write-review-box" open="@(reviewError is not null)">
                    <summary class="write-review">
                        <span class="avatar">@initial</span>
                        <span class="write-review-text">@(mine is null ? "Write a review" : "Edit your review")</span>
                    </summary>
                    <form class="review-form order-review" method="post" asp-controller="Orders" asp-action="Review" asp-route-id="@reviewOrderId">
                        @if (reviewError is not null)
                        {
                            <p class="entry-error">@reviewError</p>
                        }
                        <span class="entry-caption">Shop</span>
                        <div class="star-input" role="radiogroup" aria-label="Shop rating">
                            @for (var i = 5; i >= 1; i--)
                            {
                                <input type="radio" name="shopRating" value="@i" id="shop-@i" checked="@((mine?.ShopRating ?? 5) == i)" />
                                <label for="shop-@i" aria-label="@i stars">★</label>
                            }
                        </div>
                        <textarea name="shopText" rows="2" maxlength="500" placeholder="How was the shop?">@mine?.ShopText</textarea>
                        <span class="entry-caption">Delivery</span>
                        <div class="star-input" role="radiogroup" aria-label="Delivery rating">
                            @for (var i = 5; i >= 1; i--)
                            {
                                <input type="radio" name="deliveryRating" value="@i" id="delivery-@i" checked="@((mine?.DeliveryRating ?? 5) == i)" />
                                <label for="delivery-@i" aria-label="@i stars">★</label>
                            }
                        </div>
                        <textarea name="deliveryText" rows="2" maxlength="500" placeholder="How was the delivery?">@mine?.DeliveryText</textarea>
                        <span class="entry-caption">Comment</span>
                        <textarea name="comment" rows="3" maxlength="1000" placeholder="Anything else you want to tell us">@mine?.Comment</textarea>
                        <div class="review-form-actions">
                            <button type="submit" class="account-signin">@(mine is null ? "Send the review" : "Save")</button>
                        </div>
                    </form>
                </details>
            }
            else
            {
                <div class="write-review is-off">
                    <span class="avatar">@initial</span>
                    <span class="write-review-text">You can write a review once your order is delivered</span>
                </div>
            }
            <div class="opinion-list" aria-label="Customer comments">
                @if (Model.Items.Count == 0 && Model.Total > 0)
                {
                    <p class="comments-empty">No reviews match your filters. <a href="/Reviews">Show all reviews</a></p>
                }
                else if (Model.Items.Count == 0)
                {
                    <p class="comments-empty">No reviews yet. After your order is delivered, you can rate the shop and the delivery on the order page.</p>
                }
                else
                {
                    <div class="review-grid review-grid-single">
                        @foreach (var review in Model.Items)
                        {
                            <partial name="_ShopReview" model="review" />
                        }
                    </div>
                    @if (Model.HasMore)
                    {
                        <a class="section-more" href="/Reviews?@Model.FilterQuery(Model.Page + 1)">Show more</a>
                    }
                }
            </div>
        </section>    </main>
