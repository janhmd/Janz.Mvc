@model HomeIndexVM

@if (Model.Newest.Count > 0)
{
    <section id="new">
        <h2><a class="section-link" href="/Products">New</a></h2>
        <div class="card-grid">
            @foreach (var product in Model.Newest)
            {
                <partial name="_ProductCard" model="product" />
            }
        </div>
    </section>
}
