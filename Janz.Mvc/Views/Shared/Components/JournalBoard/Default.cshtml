@model Janz.Mvc.ViewModels.Journal.JournalPageVM
@using Janz.Mvc.ViewModels.Journal
@{
    var hero = Model.Articles.OrderByDescending(m => m.PublishedAt).FirstOrDefault();
    // Hər seriyadan ən köhnə məqalə: seriyanı oxumağa ondan başlamaq olar
    var series = Model.Articles.Where(m => !string.IsNullOrEmpty(m.Series)).GroupBy(m => m.Series).Select(g => g.OrderBy(m => m.PublishedAt).First()).ToList();
}

<div class="journal-board">
    <div class="journal-side">
        <h3>Tags</h3>
        <div class="journal-tags">
            @foreach (var tag in JournalPageVM.Tags)
            {
                <a href="/Journal?tag=@Uri.EscapeDataString(tag)" class="@(Model.Tag == tag ? "is-on" : null)" data-tag="@tag"># @tag</a>
            }
            <a href="/Journal" data-tag="">All tags</a>
        </div>
        @if (series.Count > 0)
        {
            <h3>Article series</h3>
            @foreach (var item in series)
            {
                <a class="journal-series" href="/Journal/Article/@item.Slug">@item.Series</a>
            }
        }
    </div>
    <div>
        <div class="journal-recent" hidden>
            <h2><a href="/Profile#journal">Recently read <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5.5l6.5 6.5L9 18.5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a></h2>
            <div class="journal-recent-row"></div>
        </div>
        <div class="journal-toolbar">
            <h2>All articles</h2>
            <select aria-label="Sort">
                <option>Newest first</option>
                <option>Oldest first</option>
                <option>Most read</option>
                <option>Most popular</option>
            </select>
            <span class="journal-count">@Model.Articles.Count articles</span>
        </div>
        <div class="journal-grid">
            @foreach (var article in Model.Articles.Where(m => m != hero))
            {
                <partial name="_ArticleCard" model="article" />
            }
            <p class="journal-none" hidden="@(Model.Articles.Count > 1)">@(ViewBag.Error as string ?? "No articles on this topic yet")</p>
        </div>
    </div>
</div>
