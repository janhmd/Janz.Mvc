@model Janz.Mvc.ViewModels.Profile.ProfilePageVM

<div class="cabinet-pane" data-pane="messages" hidden>
    @if (TempData["MessageError"] is string messageError)
    {
        <p class="entry-error">@messageError</p>
    }
    <div class="my-messages">
        @foreach (var item in Model.Messages)
        {
            <article class="my-message">
                <div class="my-message-head">
                    <strong>@item.Topic</strong>
                    <time datetime="@item.CreatedAt.ToLocalTime().ToString("yyyy-MM-ddTHH:mm")">@item.CreatedAt.ToLocalTime().ToString("d MMMM yyyy, HH:mm")</time>
                    <span class="my-message-state@(item.IsAnswered || item.IsClosed ? " is-answered" : string.Empty)">@(item.IsClosed ? "Closed by support" : item.IsAnswered ? "Answered" : "Waiting for a reply")</span>
                </div>
                <div class="chat">
                    <div class="chat-msg is-customer">
                        <span class="chat-who">You, @item.CreatedAt.ToLocalTime().ToString("d MMMM yyyy, HH:mm")</span>
                        <p>@item.Message</p>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(item.Reply))
                    {
                        <div class="chat-msg is-staff">
                            <span class="chat-who">Janz support@(item.AnsweredAt is null ? string.Empty : ", " + item.AnsweredAt.Value.ToLocalTime().ToString("d MMMM yyyy, HH:mm"))</span>
                            <p>@item.Reply</p>
                        </div>
                    }
                    @foreach (var entry in item.Entries)
                    {
                        <div class="chat-msg @(entry.IsStaff ? "is-staff" : "is-customer")">
                            <span class="chat-who">@(entry.IsStaff ? "Janz support" : "You"), @entry.CreatedAt.ToLocalTime().ToString("d MMMM yyyy, HH:mm")</span>
                            <p>@entry.Text</p>
                        </div>
                    }
                </div>
                @if (item.CanFollowUp)
                {
                    @* Cavab kömək etməyibsə yenidən yazmaq və ya söhbəti bitirmək olar; söhbət yalnız müştəri bitirəndə bağlanır *@
                    <form class="order-refund" method="post" asp-controller="Profile" asp-action="MessageFollowUp" asp-route-id="@item.Id">
                        <span>Did this answer help?</span>
                        <p>If not, write to us again and we will answer.</p>
                        <textarea name="text" rows="3" maxlength="2000" required placeholder="Write your message"></textarea>
                        <button type="submit" class="cart-place">Send</button>
                    </form>
                }
                else if (item.IsClosed)
                {
                    <p class="order-help">Support ended this chat@(item.ClosedAt is null ? string.Empty : " on " + item.ClosedAt.Value.ToLocalTime().ToString("d MMMM yyyy")). <a href="/Contact">Write a new message</a></p>
                }
            </article>
        }
    </div>
    <div class="cabinet-empty" hidden="@(Model.Messages.Count > 0)">
        <h2>No messages yet</h2>
        <p>What you write to support appears here together with the answer.</p>
        <a href="/Contact">Write to support</a>
    </div>
    @if (Model.Messages.Count > 0)
    {
        <p class="order-help">Another question? <a href="/Contact">Write to support</a></p>
    }
</div>
