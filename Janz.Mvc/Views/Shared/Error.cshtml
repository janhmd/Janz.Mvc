@model ErrorVM
@{
    ViewData["Title"] = Model.Title;
}

<main>
    <section id="error">
        <div class="wish-empty error-page">
            <p class="error-code">@Model.Status</p>
            <h1>@Model.Title</h1>
            <p>@Model.Message</p>
            <a asp-controller="Home" asp-action="Index">Go to home</a>
        </div>
    </section>
</main>
