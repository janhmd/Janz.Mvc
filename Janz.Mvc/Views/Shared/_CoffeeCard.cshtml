@model CoffeeCard
@{
    var grinds = new[]
    {
        "Whole beans", "For French press (coarse)", "For drip coffee maker (coarse)", "For Chemex (coarse)",
        "For pour-over (medium)", "For AeroPress (medium)", "For moka pot (medium)", "For espresso, coarse (medium)",
        "For espresso, fine (fine)", "For Turkish coffee (fine)", "For a cup (medium)"
    };
}

<article class="product">
    <div class="product-top">
        <p>@Model.Use</p>
        <div class="product-meta">
            <p class="rating">
                <span class="rating-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>@Model.Rating</span>
                <span class="rating-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z" /></svg>@Model.Reviews</span>
            </p>
            @if (Model.CoffeeOfTheWeek)
            {
                <div class="badges">
                    <span>Coffee of the week</span>
                </div>
            }
            @if (Model.Tag != null)
            {
                <p class="tag-note">@Model.Tag</p>
            }
        </div>
    </div>
    <div class="product-head">
        <h3><a class="product-link" href="#">@Model.Name</a></h3>
        <p class="kind">@Model.Kind</p>
    </div>
    <div class="photo-wrap">
        <img class="product-photo" src="@Url.Content("~/images/" + Model.Image)" alt="@Model.Name coffee" />
        @if (Model.Sticker == CoffeeSticker.QGrade)
        {
            <svg class="sticker" viewBox="0 0 100 100" aria-label="Q-grader score 87+">
                <circle cx="50" cy="50" r="48" />
                <text class="sticker-ring"><textPath href="#sticker-ring">Q-GRADER SCORE • LIMITED MICROLOT •</textPath></text>
                <text class="sticker-score" x="50" y="59" text-anchor="middle">87+</text>
            </svg>
        }
        else if (Model.Sticker == CoffeeSticker.Milk)
        {
            <svg class="sticker" viewBox="0 0 100 100" aria-label="For milk drinks">
                <circle cx="50" cy="50" r="48" />
                <text class="sticker-ring"><textPath href="#sticker-ring">FOR MILK DRINKS • FOR MILK DRINKS •</textPath></text>
                <path class="sticker-icon" d="M45 32h10v7l4 6v19a3 3 0 0 1-3 3H44a3 3 0 0 1-3-3V45l4-6z M41 52h18" />
            </svg>
        }
    </div>
    <p class="taste">
        @Model.TasteLead
        @for (var i = 0; i < Model.Notes.Length; i++)
        {
            <text><span class="note @Model.Notes[i].CssClass">@Model.Notes[i].Name</span>@(i < Model.Notes.Length - 2 ? ", " : i == Model.Notes.Length - 2 ? " and " : "")</text>
        }
        @Model.TasteTail
    </p>
    <div class="meters">
        <div>
            <span>Density</span>
            <i><b style="width:@(Model.Density)%"></b></i>
        </div>
        <div>
            <span>Acidity</span>
            <i><b style="width:@(Model.Acidity)%"></b></i>
        </div>
    </div>
    <div class="buy-row">
        <button type="button" class="weight is-on">250 g @if (Model.SmallDiscount != null) { <small>@Model.SmallDiscount</small> }</button>
        <button type="button" class="weight">1000 g @if (Model.LargeDiscount != null) { <small>@Model.LargeDiscount</small> }</button>
        <button type="button" class="weight-info" title="Buy more, pay less: bigger packs come with a discount">i</button>
        <details class="grind click-menu">
            <summary><span>@grinds[0]</span></summary>
            <div class="grind-list">
                <p>Grind</p>
                @foreach (var grind in grinds)
                {
                    <button type="button" class="@(grind == grinds[0] ? "is-on" : null)">@grind</button>
                }
            </div>
        </details>
    </div>
    <div class="price-row">
        <button type="button" class="price">
            @if (Model.OldPrice != null)
            {
                <s>@Model.OldPrice</s>
            }
            <strong>@Model.Price</strong>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 8h15v11.5a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8M9.3 14.2l1.9 1.9 3.6-3.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <span class="product-actions">
            <button type="button" aria-label="Add to wishlist"><svg viewBox="0 0 24 24"><path d="M12 19s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
            <button type="button" aria-label="Compare"><svg viewBox="0 0 24 24"><path d="M12 3v15M8 20h8M4.5 7h15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0zM19.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></button>
            <button type="button" aria-label="Product details"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4M9.5 12h5M9.5 15.5h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
        </span>
    </div>
</article>
