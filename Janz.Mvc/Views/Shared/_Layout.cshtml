<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Janz</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="logo" asp-controller="Home" asp-action="Index" aria-label="Janz">
            <span class="logo-mark" aria-hidden="true">J</span>
            <span class="logo-name">Janz</span>
        </a>

        <nav class="main-nav" aria-label="Main">
            <a asp-controller="Home" asp-action="Index">Home</a>
            <a href="#">About Us</a>

            <div class="nav-drop">
                <a href="#">Products</a>
                <div class="nav-panel">
                    <a href="#">Products</a>
                    <a href="#">Product Details</a>
                </div>
            </div>

            <div class="nav-drop">
                <a href="#">Page</a>
                <div class="nav-panel">
                    <a href="#">Pricing</a>
                    <a href="#">Team</a>
                    <a href="#">Help Center</a>
                    <a href="#">Error 404</a>
                </div>
            </div>

            <a href="#">Contact Us</a>
        </nav>

        <div class="header-actions">
            <a class="btn-start" href="#">Get Started</a>
            <a class="btn-phone" href="tel:+994500000000" aria-label="Call">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M6.6 3.8c.4-.4 1-.5 1.5-.3l2.2.9c.5.2.8.7.8 1.2l-.2 2.4c0 .4-.2.8-.6 1l-1.3.7a12.4 12.4 0 0 0 5.4 5.4l.7-1.3c.2-.4.6-.6 1-.6l2.4-.2c.5 0 1 .3 1.2.8l.9 2.2c.2.5.1 1.1-.3 1.5l-1.6 1.6c-.4.4-1 .6-1.6.5C10.8 19.8 4.2 13.2 3.3 6.9c-.1-.6.1-1.2.5-1.6l1.6-1.5z"/>
                </svg>
            </a>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
