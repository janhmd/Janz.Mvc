<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Janz</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <div class="site-header">
        <a class="logo" asp-controller="Home" asp-action="Index" aria-label="Janz">
            <span class="logo-mark" aria-hidden="true">J</span>
            <span class="logo-name">Janz</span>
        </a>

        <nav aria-label="Main">
            <div class="nav-drop">
                <a class="menu-toggle" href="#">Buy</a>
                <div class="menu-panel">
                    <a asp-controller="Home" asp-action="Catalog">Coffee</a>
                    <a asp-controller="Home" asp-action="Tea">Tea</a>
                    <a asp-controller="Home" asp-action="Chocolate">Chocolate and syrups</a>
                    <a asp-controller="Home" asp-action="Sets">Sets</a>
                </div>
            </div>
            <a asp-controller="Home" asp-action="Reviews">Reviews <span class="nav-count">44,828</span></a>
            <a href="#">Community</a>
            <a href="#">Journal</a>
            <div class="nav-drop">
                <a href="#">Terms</a>
                <div class="menu-panel">
                    <a href="#">Delivery and payment</a>
                    <a href="#">Discount system</a>
                    <a href="#">Refunds</a>
                    <a href="#">FAQ</a>
                </div>
            </div>
        </nav>

        <div class="header-actions">
            <a class="icon-btn" href="#" aria-label="Search">
                <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </a>
            <details class="profile click-menu">
                <summary class="icon-btn" aria-label="Account">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.2" fill="none" stroke="currentColor" stroke-width="1.6"/><circle cx="12" cy="10" r="2.2" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M7.8 16.2a4.4 4.4 0 0 1 8.4 0" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
                </summary>
                <div class="profile-panel">
                    <a href="#">Sign in</a>
                    <a href="#">Register</a>
                </div>
            </details>
            <a class="icon-btn" href="#" aria-label="Wishlist">
                <svg viewBox="0 0 24 24"><path d="M12 19s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg>
            </a>
            <a class="icon-btn" href="#" aria-label="Compare">
                <svg viewBox="0 0 24 24"><path d="M12 3v15M8 20h8M4.5 7h15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0zM19.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>
            </a>
            <a class="cart-link" href="#" aria-label="Cart, 0 items">
                <svg viewBox="0 0 24 24"><path d="M6 7h15l-1.5 9h-12z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M6 7L5 4H2" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><circle cx="9" cy="20" r="1.2" fill="currentColor"/><circle cx="17" cy="20" r="1.2" fill="currentColor"/></svg>
                <span>0 pcs</span>
            </a>
        </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer>
        <div class="site-footer">
            <div class="footer-brand">
                <a class="logo" asp-controller="Home" asp-action="Index" aria-label="Janz">
                    <span class="logo-mark" aria-hidden="true">J</span>
                    <span class="logo-name">Janz</span>
                </a>
                <p>© 2026 Janz. Materials on this site may be used only with the owner's written permission.</p>
                <a asp-controller="Home" asp-action="Privacy">Privacy policy</a>
            </div>
            <div class="footer-col">
                <div class="footer-title">Catalog</div>
                <a asp-controller="Home" asp-action="Catalog">Coffee</a>
                <a asp-controller="Home" asp-action="Tea">Tea</a>
                <a asp-controller="Home" asp-action="Chocolate">Chocolate and syrups</a>
                <a asp-controller="Home" asp-action="Sets">Sets</a>
            </div>
            <div class="footer-col">
                <div class="footer-title">Help</div>
                <a href="#">Community</a>
                <a href="#">Journal</a>
                <a href="#">Delivery and payment</a>
                <a href="#">Discount system</a>
                <a href="#">Refunds</a>
                <a href="#">FAQ</a>
            </div>
            <div class="footer-contacts">
                <div class="footer-title">Contacts</div>
                <a class="footer-phone" href="tel:+994702175557">+994 70 217 55 57</a>
                <p>Nesimi, Masud Davudoglu 171</p>
                <div class="footer-social">
                    <a href="mailto:janahmadap@code.edu.az" aria-label="Email">
                        <svg viewBox="0 0 24 24"><path d="M3.5 6.5h17v11h-17z" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M3.5 7l8.5 6.5L20.5 7" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>
                    </a>
                    <a href="https://instagram.com/prglnv" aria-label="Instagram">
                        <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="4" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="12" cy="12" r="3.4" fill="none" stroke="currentColor" stroke-width="1.7"/><circle cx="17.1" cy="6.9" r=".9" fill="currentColor"/></svg>
                    </a>
                    <a href="https://wa.me/994702175557" aria-label="WhatsApp">
                        <svg viewBox="0 0 24 24"><path d="M12 4.2a7.6 7.6 0 0 0-6.6 11.3L4.4 19.6l4.2-1.1A7.6 7.6 0 1 0 12 4.2z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M9.2 9.4c.2-.4.4-.4.6-.4h.5c.2 0 .4 0 .5.4.2.5.6 1.5.6 1.6s0 .3-.2.5l-.3.4c-.1.1-.2.3 0 .5.2.3.7 1.1 1.5 1.5.6.3 1 .4 1.2.2l.5-.6c.1-.2.3-.1.5-.1.6.2 1.3.6 1.4.8.1.2.1.7-.2 1.1-.2.4-1.2.8-1.7.7-.5 0-1.1-.1-2.4-.9-1.5-.9-2.5-2.3-2.6-2.5-.2-.3-.8-1.1-.8-2.1s.6-1.5.8-1.7z" fill="currentColor"/></svg>
                    </a>
                </div>
            </div>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        document.addEventListener("click", function (event) {
            if (event.target.closest(".menu-toggle")) event.preventDefault();
            document.querySelectorAll(".click-menu[open]").forEach(function (menu) {
                if (!menu.contains(event.target)) menu.removeAttribute("open");
            });
        });
    </script>
</body>
</html>
