@model List<Janz.Mvc.ViewModels.Community.CommunityPersonUIVM>
@foreach (var person in Model)
{
    var author = person.Author;
    var slug = string.IsNullOrWhiteSpace(author.Nickname) ? author.UserId : author.Nickname;
    <a class="follow-item" href="/Community/Profile/@Uri.EscapeDataString(slug)">
        <span class="blacklist-avatar">@if (!string.IsNullOrEmpty(author.AvatarPath)){<img src="@author.AvatarPath" alt="" />}else{@(string.IsNullOrWhiteSpace(author.Name) ? "C" : author.Name.Substring(0, 1).ToUpper())}</span>
        <span class="follow-who"><strong>@author.Name</strong><em>@author.Role</em></span>
    </a>
}
@if (Model.Count == 0)
{
    <p class="follow-none">Nobody here yet</p>
}
