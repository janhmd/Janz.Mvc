@using Janz.Mvc.Helpers
@model Janz.Mvc.ViewModels.Products.ProductUIVM
@inject IConfiguration Configuration
@{
    var isSet = string.Equals(Model.CategorySlug, "sets", StringComparison.OrdinalIgnoreCase);
}
<article>
    <div class="product@(isSet ? " set-card" : string.Empty)">
        <div class="product-top">
            <p>@Model.CategoryName</p>
            @if (!string.IsNullOrEmpty(Model.Badge))
            {
                <div class="product-meta">
                    <div class="badges"><span>@Model.Badge</span></div>
                </div>
            }
        </div>
        <h3><a class="product-link" href="/Products/Detail/@Model.Id">@Model.Name</a></h3>
        <img class="product-photo" src="@ApiUrl.ToAbsolute(Configuration["ApiSettings:BaseUrl"], Model.ImagePath)" alt="@Model.Name" />
        <div class="taste">@Model.Description</div>
        <div class="kind">@Model.Stock in stock</div>
        <div class="price-row">
            <button type="button" class="price" data-cart-add="@Model.Id" disabled="@(Model.Stock <= 0)">@if (Model.DiscountPercent > 0){<small>-@Model.DiscountPercent%</small><s>₼@Model.OldPrice!.Value.ToString("0.00")</s>}<strong>₼@Model.Price.ToString("0.00")</strong></button>
            @* Müqayisə brauzerdə saxlanılır (site.js: data-compare-toggle), ətraflı düyməsi məhsul səhifəsini açır *@
            <span class="product-actions">
                <button type="button" aria-label="Compare" data-compare-toggle="@Model.Id"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3v15M8 20h8M4.5 7h15" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/><path d="M4.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0zM19.5 7l-2.2 4.2a2.6 2.6 0 0 0 4.4 0z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg></button>
                <a class="product-details" href="/Products/Detail/@Model.Id" aria-label="Product details"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h7l4 4v14H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4M10 12h5M10 15.5h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></a>
            </span>
        </div>
    </div>
</article>
