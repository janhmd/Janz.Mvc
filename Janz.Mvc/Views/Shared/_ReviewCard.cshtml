@model ReviewCard

<article>
    <div class="review">
        <div class="review-head">
            <div class="reviewer">
                <div class="avatar">@Model.Initial</div>
                <div>
                    <div class="reviewer-name">@Model.Name</div>
                    <div class="reviewer-level">@Model.Level</div>
                </div>
            </div>
            <div class="review-date">@Model.Date</div>
        </div>
        <div class="review-label">Shop <span class="stars">@(new string('★', Model.ShopStars))</span></div>
        <p>@Model.ShopText</p>
        <div class="review-label">Delivery <span class="stars">@(new string('★', Model.DeliveryStars))</span></div>
        <p>@Model.DeliveryText</p>
        <div class="review-label">Comment</div>
        <p>@Model.Comment</p>
    </div>
</article>
