@model SetCard
@{
    var grinds = new[]
    {
        "Whole beans", "For French press (coarse)", "For drip coffee maker (coarse)", "For Chemex (coarse)",
        "For pour-over (medium)", "For AeroPress (medium)", "For moka pot (medium)", "For espresso, coarse (medium)",
        "For espresso, fine (fine)", "For Turkish coffee (fine)", "For a cup (medium)"
    };
}

<article>
    <div class="product set-card">
    <div class="product-top">
        <p>@Model.Category</p>
        <div class="product-meta">
            <div class="rating">
                <span class="rating-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.5l2.6 5.3 5.9.9-4.3 4.1 1 5.8L12 16.9l-5.2 2.7 1-5.8-4.3-4.1 5.9-.9z" /></svg>@Model.Rating</span>
                <span class="rating-item"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.5a8 8 0 0 1-11.6 7.1L4 20l1.4-4.2A8 8 0 1 1 20 11.5z" /></svg>@Model.Reviews</span>
            </div>
        </div>
    </div>
    <h3><a class="product-link" href="#">@Model.Name</a></h3>
    <img class="product-photo" src="@Url.Content("~/images/" + Model.Image)" alt="@Model.Name" />
    <div class="set-text">@Model.Description</div>
    <div class="buy-row">
        <details class="grind click-menu">
            <summary><span>@grinds[0]</span></summary>
            <div class="grind-list">
                <p>Grind</p>
                @foreach (var grind in grinds)
                {
                    <button type="button" class="@(grind == grinds[0] ? "is-on" : null)">@grind</button>
                }
            </div>
        </details>
    </div>
    <div class="price-row">
        <button type="button" class="price">
            <strong>@Model.Price</strong>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.5 8h15v11.5a1.5 1.5 0 0 1-1.5 1.5H6a1.5 1.5 0 0 1-1.5-1.5z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round" /><path d="M9 8V6.5a3 3 0 0 1 6 0V8M9.3 14.2l1.9 1.9 3.6-3.8" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <span class="product-actions">
            <button type="button" aria-label="Add to wishlist"><svg viewBox="0 0 24 24"><path d="M12 19s-7-4.4-7-9a4 4 0 0 1 7-2 4 4 0 0 1 7 2c0 4.6-7 9-7 9z" fill="none" stroke="currentColor" stroke-width="1.6"/></svg></button>
            <button type="button" aria-label="Product details"><svg viewBox="0 0 24 24"><path d="M7 3h7l4 4v14H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4M9.5 12h5M9.5 15.5h5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></button>
        </span>
    </div>
    </div>
</article>
